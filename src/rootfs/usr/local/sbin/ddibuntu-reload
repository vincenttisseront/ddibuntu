#!/bin/bash
# ddibuntu-reload — applique, en root, la configuration déposée par la console web (utilisateur sans privilège).
# Frontière de privilèges : le contenu vient d'un processus non privilégié, donc il est contrôlé avant installation
# (pas d'include arbitraire, pas de hooks Kea, chemins imposés), validé par les outils officiels, et restauré en cas d'échec.
set -euo pipefail
umask 022

GEN="${DDI_GENERATED_DIR:-/var/lib/ddibuntu/generated}"
BIND_ETC="${DDI_BIND_ETC:-/etc/bind}"
ZONES="${DDI_ZONES_RUNTIME_DIR:-/var/lib/bind/ddibuntu}"
KEA_ETC="${DDI_KEA_ETC:-/etc/kea}"
STATE="${DDI_STATE_DIR:-/var/lib/ddibuntu}"
CLUSTER_DIR="${DDI_CLUSTER_DIR:-/etc/ddibuntu-cluster}"      # lu seulement s'il existe : racine de confiance (root), jamais écrit par la console
AD_DIR="${DDI_AD_DIR:-/etc/ddibuntu-ad}"                      # domaine Kerberos configuré par root (ddibuntu-ad) : seule source des « update-policy » Kerberos
KEA_HOOKS="${DDI_KEA_HOOKS_DIR:-}"                            # vide = recherche /usr/lib/*/kea/hooks
KEA_LEASES="${DDI_KEA_LEASE_FILE:-/var/lib/kea/kea-leases4.csv}"
case "${1:-}" in
  "") MODE=full ;;
  --kea-only) MODE=kea-only ;;     # applique seulement Kea (nœud primaire dont les fichiers BIND ne changent pas)
  --replica) MODE=replica ;;       # nœud secondaire : Kea + BIND secondaire (zones transférées)
  --promote) MODE=promote ;;       # ce nœud vient de devenir leader : BIND passe de secondaire à primaire en gardant les zones transférées
  *) echo "usage : ddibuntu-reload [--kea-only|--replica|--promote]" >&2; exit 2 ;;
esac
BACKUP="$STATE/backup"
STATUS="$STATE/reload-status"; ROLLED_BACK=0
log() { printf 'ddibuntu-reload: %s\n' "$*"; logger -t ddibuntu-reload -- "$*" 2>/dev/null || true; }
# Résultat lisible par la console web (aucune donnée sensible) : at=epoch, ok=1|0, message=une ligne
status() {
  local m; m="$(printf '%s' "$2" | tr '\n\r' '  ' | cut -c1-300)"
  mkdir -p "$STATE" 2>/dev/null || return 0
  { printf 'at=%s\nok=%s\nmessage=%s\n' "$(date +%s)" "$1" "$m" > "$STATUS.new" && chmod 0644 "$STATUS.new" && mv -f "$STATUS.new" "$STATUS"; } 2>/dev/null || true
}
fail() {
  local m="$*"
  if [ "$ROLLED_BACK" -eq 1 ]; then m="$m (retour arrière automatique effectué)"; fi
  printf 'ddibuntu-reload: ERREUR : %s\n' "$m" >&2; logger -t ddibuntu-reload -p user.err -- "$m" 2>/dev/null || true
  status 0 "$m"; exit 1
}

[ "$(id -u)" -eq 0 ] || fail "à lancer en root"
# une seule application à la fois (la console, « follow » du cluster et les essais peuvent la lancer en même temps)
exec 9>"${DDI_LOCK_FILE:-/run/ddibuntu-reload.lock}"
flock -w 120 9 || fail "une autre application de configuration est en cours depuis plus de 2 minutes"
req="named.conf.options named.conf.zones kea-dhcp4.conf"; if [ "$MODE" = kea-only ]; then req="kea-dhcp4.conf"; fi
for f in $req; do [ -f "$GEN/$f" ] || fail "fichier absent : $GEN/$f"; done

# ---- Contrôles de la frontière de privilèges ----
check_named() {   # $1 = fichier de configuration BIND généré
  local f="$1" bad
  bad="$(grep -nE '^[[:space:]]*include[[:space:]]' "$f" | grep -vF 'include "/etc/bind/ddi-ddns.key";' || true)"
  [ -z "$bad" ] || fail "directive include refusée dans $(basename "$f") : $bad"
  if grep -nE '(^|[^a-zA-Z-])(controls|dyndb|plugin|trust-anchors|managed-keys|session-keyfile|pid-file|lock-file|tkey-gssapi-keytab|tkey-gssapi-credential|tkey-domain|tkey-dhkey)([^a-zA-Z-]|$)' "$f" | grep -q .; then fail "directive interdite dans $(basename "$f")"; fi
  bad="$(grep -oE '(^|[^a-zA-Z-])(directory|file) "[^"]*"' "$f" | sed -E 's/^[^a-z]*//' | grep -vE "^file \"($ZONES/[A-Za-z0-9._-]+|/var/log/named/query\.log)\"$|^directory \"/var/cache/bind\"$" || true)"
  [ -z "$bad" ] || fail "chemin refusé dans $(basename "$f") : $bad"
}
check_zone() {    # $1 = fichier de zone
  # shellcheck disable=SC2016  # « $INCLUDE » est une directive de zone littérale, pas une variable
  if grep -qiE '^[[:space:]]*\$(INCLUDE|GENERATE)' "$1"; then fail "directive \$INCLUDE/\$GENERATE refusée dans $(basename "$1")"; fi
  case "$(basename "$1")" in db.*) ;; *) fail "nom de fichier de zone inattendu : $1" ;; esac
}
check_kea() {     # $1 = kea-dhcp4.conf
  python3 - "$1" <<'PY' || fail "configuration Kea refusée (voir ci-dessus)"
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception as e:
    sys.exit("JSON illisible : %s" % e)
if set(d) != {"Dhcp4"}: sys.exit("clés de premier niveau inattendues : %s" % sorted(d))
k = d["Dhcp4"]
if "hooks-libraries" in k: sys.exit("hooks-libraries interdit (exécution de code)")
sock = k.get("control-socket", {}).get("socket-name", "")
if not sock.startswith("/run/kea/") or ".." in sock: sys.exit("socket de contrôle hors de /run/kea")
if k.get("lease-database", {}).get("host", "127.0.0.1") not in ("127.0.0.1", "localhost"): sys.exit("base de baux distante refusée")
for lg in k.get("loggers", []):
    for o in lg.get("output_options", []):
        if o.get("output") not in ("stdout", "stderr", "syslog"): sys.exit("sortie de journal refusée : %s" % o.get("output"))
PY
}

# ---- Cluster : Kea HA et BIND primaire/secondaire ----
# Tout ce qui suit est ajouté ICI, par root, à partir de la configuration du cluster (cluster.conf, fichier root) : jamais depuis la console.
#  · Kea : le bloc « hooks-libraries » (exécution de code) est refusé s'il vient de la console ; les baux passent en fichier local (la base est en
#    lecture seule sur le secondaire), le hook HA les synchronise en TLS mutuel sur le réseau dédié.
#  · BIND : clé TSIG « ddi-xfr », écoute sur l'adresse du réseau dédié, transfert de zone réservé à cette clé, NOTIFY signé ; le secondaire est dérivé
#    des mêmes fichiers (zones primaires → secondaires), RPZ comprise. Une ligne inattendue fait REFUSER la transformation (jamais « au mieux »).
# Codes de sortie des sondes : 0 = s'applique, 1 = ne s'applique pas (pas de cluster, arbitre, un seul nœud de données), 2 = cluster.conf invalide.
cluster_py() {
  python3 - "$@" <<'PY'
import base64, glob, hashlib, hmac, ipaddress, json, os, re, sys
mode, cldir = sys.argv[1], sys.argv[2]
def die(m): sys.stderr.write("cluster : %s\n" % m); sys.exit(2)
def cluster():
    conf = os.path.join(cldir, "cluster.conf")
    if not os.path.isfile(conf): return None
    c = {}
    for line in open(conf, encoding="utf-8"):
        line = line.rstrip("\n")
        if not line or line.startswith("#"): continue
        m = re.fullmatch(r"([A-Z_]+)=([A-Za-z0-9._:/,= -]*)", line)
        if not m: die("cluster.conf : ligne illisible")
        c[m.group(1)] = m.group(2)
    name, role = c.get("NODE_NAME", ""), c.get("NODE_ROLE", "")
    if role != "data": return None
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,30}", name): die("NODE_NAME invalide")
    try: ipaddress.IPv4Address(c.get("NODE_IP", ""))
    except ValueError: die("NODE_IP invalide")
    data = []
    for p in c.get("PEERS", "").split():
        m = re.fullmatch(r"([a-z][a-z0-9-]{1,30})=([0-9.]+):(data|witness)", p)
        if not m: die("PEERS invalide")
        try: ipaddress.IPv4Address(m.group(2))
        except ValueError: die("adresse de pair invalide")
        if m.group(3) == "data": data.append((m.group(1), m.group(2)))
    if len(data) != 2: return None
    if name not in [n for n, _ in data]: die("ce nœud ne figure pas dans PEERS")
    data.sort()                       # même ordre sur les deux nœuds : le premier par nom est « primary » du hook HA de Kea
    return name, c["NODE_IP"], data

cl = cluster()
if mode in ("kea-probe", "bind-probe"): sys.exit(0 if cl else 1)

if mode == "kea-render":
    src, hooks, leases = sys.argv[3:6]
    d = json.load(open(src))
    if not cl:
        json.dump(d, sys.stdout, indent=2); sys.stdout.write("\n"); sys.exit(0)
    name, _, data = cl
    lib = lambda n: (glob.glob(os.path.join(hooks, n)) if hooks else glob.glob("/usr/lib/*/kea/hooks/" + n))
    ha_lib, lc_lib = lib("libdhcp_ha.so"), lib("libdhcp_lease_cmds.so")
    if not ha_lib or not lc_lib: die("bibliothèques Kea HA introuvables (paquet kea-dhcp4-server)")
    pki = os.path.join(cldir, "pki")
    for f in ("ca.crt", "node.crt", "node.key"):
        if not os.path.isfile(os.path.join(pki, f)): die("matériel TLS du cluster absent : pki/" + f)   # « kea-dhcp4 -t » ne lit pas ces fichiers
    k = d["Dhcp4"]
    k["lease-database"] = {"type": "memfile", "persist": True, "name": leases, "lfc-interval": 3600}
    k["hooks-libraries"] = [
      {"library": lc_lib[0]},
      {"library": ha_lib[0], "parameters": {"high-availability": [{
        "this-server-name": name, "mode": "load-balancing",
        "heartbeat-delay": 10000, "max-response-delay": 60000, "max-ack-delay": 5000, "max-unacked-clients": 5,
        "multi-threading": {"enable-multi-threading": True, "http-dedicated-listener": True, "http-listener-threads": 4, "http-client-threads": 4},
        "trust-anchor": os.path.join(pki, "ca.crt"), "cert-file": os.path.join(pki, "node.crt"), "key-file": os.path.join(pki, "node.key"),
        "peers": [{"name": n, "url": "https://%s:8000/" % ip, "role": ("primary" if i == 0 else "secondary"), "auto-failover": True} for i, (n, ip) in enumerate(data)],
      }]}},
    ]
    json.dump(d, sys.stdout, indent=2); sys.stdout.write("\n"); sys.exit(0)

if mode == "bind-render":
    role, opts_src, zones_src, out_opts, out_zones, keyfile, out_vkeys = sys.argv[3:10]
    if not cl: die("pas de cluster à deux nœuds de données")
    if role not in ("primary", "secondary"): die("rôle BIND inconnu")
    name, node_ip, data = cl
    peer = [ip for n, ip in data if n != name][0]
    if not os.path.isfile(keyfile): die("clé de transfert TSIG absente : " + keyfile)
    out, seen, replaced = [], False, False
    for l in open(opts_src, encoding="utf-8").read().split("\n"):
        if role == "secondary" and re.fullmatch(r'include "[^"]*ddi-ddns\.key";', l): continue      # pas de mise à jour dynamique sur le secondaire
        if l == "options {":
            out.append(l); seen = True
            out.append("  listen-on { %s; };" % node_ip)                                          # le pair joint ce nœud sur le réseau dédié
            out.append("  transfer-source %s;" % node_ip)                                         # transferts, NOTIFY et rafraîchissements partent de l'adresse du réseau dédié :
            out.append("  notify-source %s;" % node_ip)                                           # c'est celle que le pair a dans ses « primaries » / son pare-feu
            out.append('  also-notify { %s key "ddi-xfr"; };' % peer if role == "primary" else "  notify no;")
            continue
        if l.strip() == "allow-transfer { none; };":
            out.append('  allow-transfer { key "ddi-xfr"; };' if role == "primary" else l); replaced = True; continue
        out.append(l)
    if not seen or not replaced: die("named.conf.options inattendu (bloc options ou allow-transfer global absent)")
    open(out_opts, "w", encoding="utf-8").write('include "%s";\n' % keyfile + "\n".join(out))
    prop = re.compile(r'\s*(notify yes;|allow-update \{ key "ddi-ddns"; \};|update-policy \{ ([^{}"]*) \};|allow-query \{ none; \};|allow-transfer \{ ([^{}"]*) \};)')
    # Vues : chaque vue a SA clé de transfert, dérivée de la clé du cluster (HMAC-SHA256 du nom de la vue) : les deux nœuds la calculent à
    # l'identique, rien de plus à distribuer. Le secondaire demande chaque zone avec la clé de SA vue, et le primaire range la requête dans la bonne vue.
    secret = re.search(r'secret "([A-Za-z0-9+/=]+)"', open(keyfile, encoding="utf-8").read())
    if not secret: die("secret illisible dans " + keyfile)
    base_secret = base64.b64decode(secret.group(1))
    def vkey(v): return "ddi-xfr-" + v
    def vsecret(v): return base64.b64encode(hmac.new(base_secret, b"ddibuntu-view:" + v.encode(), hashlib.sha256).digest()).decode()
    all_views = re.findall(r'^view "([a-z][a-z0-9-]{0,30})" \{$', open(zones_src, encoding="utf-8").read(), re.M)
    if len(set(all_views)) != len(all_views): die("vue en double")
    cur = None
    zo = []
    for l in open(zones_src, encoding="utf-8").read().split("\n"):
        m = re.fullmatch(r'view "([a-z][a-z0-9-]{0,30})" \{', l)
        if m:
            if cur: die("vue imbriquée")
            cur = m.group(1); zo.append(l); continue
        if cur and l == "};":
            if role == "primary": zo.append('  also-notify { %s key "%s"; };' % (peer, vkey(cur)))
            else: zo.append('  server %s { keys "%s"; };' % (peer, vkey(cur)))
            zo.append(l); cur = None; continue
        if cur:
            mc = re.fullmatch(r'  match-clients \{ ([^{}"]*) \};', l)
            if mc:
                # le transfert signé avec la clé de CETTE vue lui revient toujours ; signé avec la clé d'une autre vue, il ne peut pas lui revenir,
                # quelle que soit l'adresse source (celle du pair peut faire partie de la liste d'une autre vue)
                others = "".join('!key "%s"; ' % vkey(o) for o in all_views if o != cur)
                zo.append('  match-clients { key "%s"; %s%s };' % (vkey(cur), others, mc.group(1))); continue
            if re.fullmatch(r'  (match-destinations \{ [^{}"]* \};|recursion (yes|no);|allow-recursion \{ none; \};)', l): zo.append(l); continue
        if l == "" or l.startswith("//") or re.match(r'zone "[^"]+" \{ type (secondary|forward);', l):
            if l.startswith("zone") and "ddi-" in l: die("zone externe inattendue")
            zo.append(l); continue
        m = re.fullmatch(r'zone "([^"]+)" \{ type primary; file "([^"]+)";(.*) \};', l)
        if not m: die("ligne de zone inattendue : " + l[:80])
        z, f, rest = m.group(1), m.group(2), m.group(3)
        user_acl, quiet, ddns, upol, pos = "", False, False, "", 0
        while pos < len(rest):
            pm = prop.match(rest, pos)
            if not pm:
                if rest[pos:].strip() == "": break
                die("propriété de zone inattendue : " + rest[pos:pos + 60])
            t = pm.group(1)
            if t.startswith("allow-transfer"): user_acl = pm.group(3).strip()
            elif t.startswith("allow-query"): quiet = True
            elif t.startswith("allow-update"): ddns = True
            elif t.startswith("update-policy"): upol = pm.group(2).strip()
            pos = pm.end()
        kn = vkey(cur) if cur else "ddi-xfr"
        if role == "primary":
            acl = (user_acl.rstrip(";").strip() + "; " if user_acl else "") + 'key "%s";' % kn
            zo.append('zone "%s" { type primary; file "%s"; notify yes; allow-transfer { %s };%s%s };' % (z, f, acl, (' update-policy { %s };' % upol) if upol else (' allow-update { key "ddi-ddns"; };' if ddns else ""), " allow-query { none; };" if quiet else ""))
        else:
            zo.append('zone "%s" { type secondary; primaries { %s key "%s"; }; file "%s";%s };' % (z, peer, kn, f, " allow-query { none; };" if quiet else ""))
    if cur: die("vue non fermée")
    if all_views:
        vk = ["// Généré par DDI-Buntu (root) : clés de transfert par vue, dérivées de ddi-xfr.", ]
        for v in all_views: vk.append('key "%s" { algorithm hmac-sha256; secret "%s"; };' % (vkey(v), vsecret(v)))
        open(out_vkeys, "w", encoding="utf-8").write("\n".join(vk) + "\n")
        # une seule ligne « include » de plus en tête des options (relue telle quelle par la suite)
        txt = open(out_opts, encoding="utf-8").read()
        open(out_opts, "w", encoding="utf-8").write('include "%s";\n' % os.path.join(os.path.dirname(keyfile), "ddi-xfr-views.key") + txt)
    else:
        open(out_vkeys, "w", encoding="utf-8").write("")
    zo.append('server %s { keys "ddi-xfr"; };' % peer)
    open(out_zones, "w", encoding="utf-8").write("\n".join(zo) + "\n")
    sys.exit(0)
die("mode inconnu")
PY
}
# ---- Active Directory : mises à jour sécurisées (GSS-TSIG / Kerberos) ----
# La console propose des « update-policy » (clé DDNS + Kerberos) ; ICI, root les relit, les recompose à partir de SON domaine Kerberos (ddibuntu-ad
# configure) et ajoute « tkey-gssapi-keytab » (exécution d'authentification : jamais accepté de la console). Sans domaine configuré sur ce nœud, les
# octrois Kerberos sont retirés (le nœud reste utilisable, notamment après une promotion) ; un domaine différent de celui de root fait REFUSER le dépôt.
ad_py() {   # ad_py ROLE OPTIONS_SRC ZONES_SRC OPTIONS_OUT ZONES_OUT KEYTAB
  python3 - "$AD_DIR" "$@" <<'PY'
import os, re, sys
addir, role, opts_src, zones_src, opts_out, zones_out, keytab = sys.argv[1:8]
def die(m): sys.stderr.write("AD : %s\n" % m); sys.exit(2)
def warn(m): sys.stderr.write("AVERTISSEMENT : %s\n" % m)
realm = ""
conf = os.path.join(addir, "ad.conf")
if os.path.isfile(conf):
    for l in open(conf, encoding="utf-8"):
        m = re.fullmatch(r"REALM=([A-Z0-9][A-Z0-9.-]{0,61})\n?", l)
        if m: realm = m.group(1)
have_kt = os.path.isfile(keytab)
kerb = False
grant_key = re.compile(r"grant ddi-ddns zonesub ANY")
grant_krb = re.compile(r"grant ([A-Z0-9][A-Z0-9.-]{0,61}) (ms-self|krb5-self) \. A AAAA")
def policy(body, zone):
    global kerb
    out = []
    for st in [x.strip() for x in body.split(";") if x.strip()]:
        if grant_key.fullmatch(st):
            if role != "secondary": out.append("grant ddi-ddns zonesub ANY")
            continue
        m = grant_krb.fullmatch(st)
        if not m: die("update-policy refusée pour la zone %s : « %s »" % (zone, st[:70]))
        if role == "secondary": continue                      # un secondaire n'accepte aucune mise à jour : grammaire contrôlée, rien n'est retenu
        if not realm:
            warn("zone %s : domaine Kerberos non configuré sur ce nœud (ddibuntu-ad configure) : octroi %s retiré" % (zone, m.group(2))); continue
        if m.group(1) != realm: die("zone %s : domaine Kerberos « %s » différent de celui du nœud (%s)" % (zone, m.group(1), realm))
        out.append("grant %s %s . A AAAA" % (realm, m.group(2))); kerb = True
    return out
zo = []
for l in open(zones_src, encoding="utf-8").read().split("\n"):
    m = re.fullmatch(r'(zone "([^"]+)" \{ type primary; file "[^"]+";.*?)( update-policy \{ ([^{}"]*) \};)(.*)', l)
    if not m:
        if "update-policy" in l: die("ligne de zone avec update-policy inattendue : " + l[:80])
        zo.append(l); continue
    pol = policy(m.group(4), m.group(2))
    zo.append(m.group(1) + ((" update-policy { %s; };" % "; ".join(pol)) if pol else "") + m.group(5))
if kerb and role != "secondary" and not have_kt: warn("domaine %s configuré mais keytab absent (%s) : les clients Kerberos seront refusés" % (realm, keytab))
out, done = [], False
for l in open(opts_src, encoding="utf-8").read().split("\n"):
    out.append(l)
    if l == "options {" and not done:
        done = True
        if kerb and role != "secondary" and have_kt: out.append('  tkey-gssapi-keytab "%s";' % keytab)
if not done and kerb and role != "secondary" and have_kt: die("named.conf.options inattendu : ligne « options { » introuvable pour y placer tkey-gssapi-keytab")
open(opts_out, "w", encoding="utf-8").write("\n".join(out))
open(zones_out, "w", encoding="utf-8").write("\n".join(zo))
PY
}
ha_py() {   # ha_py probe|render [FICHIER]
  case "$1" in
    probe) cluster_py kea-probe "$CLUSTER_DIR" ;;
    render) cluster_py kea-render "$CLUSTER_DIR" "$2" "$KEA_HOOKS" "$KEA_LEASES" ;;
  esac
}
probe_rc() { local rc=0; cluster_py "$1" "$CLUSTER_DIR" 2>"$STATE/cluster-probe.err" || rc=$?; if [ "$rc" -gt 1 ]; then fail "cluster.conf refusé : $(tr '\n' ' ' < "$STATE/cluster-probe.err")"; fi; return "$rc"; }
KEA_GROUP="$(getent group _kea >/dev/null && echo _kea || echo root)"
XFR_KEY="$BIND_ETC/ddi-xfr.key"
install_kea() {   # écrit la configuration finale (avec bloc HA éventuel) de façon atomique
  local tmp; install -d -m 0755 "$KEA_ETC"
  tmp="$(mktemp "$KEA_ETC/.kea-dhcp4.XXXXXX")"
  if ! ha_py render "$GEN/kea-dhcp4.conf" > "$tmp"; then rm -f "$tmp"; return 1; fi
  chmod 0640 "$tmp"; chown "root:$KEA_GROUP" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$KEA_ETC/kea-dhcp4.conf"
}
verify_kea() {    # avec HA, la configuration finale est relue par Kea lui-même (bibliothèques, TLS, pairs) avant tout rechargement
  probe_rc kea-probe || return 0
  command -v kea-dhcp4 >/dev/null 2>&1 || { log "kea-dhcp4 absent : configuration HA non vérifiée"; return 0; }
  kea-dhcp4 -t "$KEA_ETC/kea-dhcp4.conf" >"$STATE/kea-verify.out" 2>&1 || { tail -n 5 "$STATE/kea-verify.out" >&2; return 1; }
}
SRC_OPTS="$GEN/named.conf.options"; SRC_ZONES="$GEN/named.conf.zones"       # remplacés par les fichiers recomposés par ad_py (voir plus bas)
install_named() {
  if [ "$bind_role" = none ]; then
    install -m 0644 -o root -g bind "$SRC_OPTS" "$BIND_ETC/named.conf.options"
    install -m 0644 -o root -g bind "$SRC_ZONES" "$BIND_ETC/named.conf.local"
    return 0
  fi
  local t; t="$(mktemp -d)"
  if ! cluster_py bind-render "$CLUSTER_DIR" "$bind_role" "$SRC_OPTS" "$SRC_ZONES" "$t/options" "$t/local" "$XFR_KEY" "$t/viewkeys" 2>"$STATE/cluster-probe.err"; then
    tr '\n' ' ' < "$STATE/cluster-probe.err" >&2; rm -rf "$t"; return 1
  fi
  # clés de transfert par vue (dérivées de ddi-xfr) : installées AVANT les options qui les incluent ; retirées quand il n'y a plus de vue
  if [ -s "$t/viewkeys" ]; then install -m 0640 -o root -g bind "$t/viewkeys" "$BIND_ETC/ddi-xfr-views.key"; else rm -f "$BIND_ETC/ddi-xfr-views.key"; fi
  install -m 0644 -o root -g bind "$t/options" "$BIND_ETC/named.conf.options"
  install -m 0644 -o root -g bind "$t/local" "$BIND_ETC/named.conf.local"
  rm -rf "$t"
}
# Rôle BIND de ce nœud : primary (déploiement local avec un pair) · secondary (--replica : zones transférées) · none (nœud seul / arbitre)
bind_role=none
prev_bind_role="$(cat "$STATE/bind-role" 2>/dev/null || true)"     # rôle appliqué la dernière fois (écrit par ce script seul)
if [ "$MODE" = replica ]; then
  probe_rc bind-probe || fail "--replica exige un cluster à deux nœuds de données"
  [ -f "$XFR_KEY" ] || fail "clé de transfert TSIG absente ($XFR_KEY) : rattacher le nœud avec un lot récent"
  bind_role=secondary
elif [ "$MODE" = promote ]; then
  probe_rc bind-probe || fail "--promote exige un cluster à deux nœuds de données"
  [ -f "$XFR_KEY" ] || fail "clé de transfert TSIG absente ($XFR_KEY) : rattacher le nœud avec un lot récent"
  bind_role=primary
elif [ "$MODE" = full ] && probe_rc bind-probe; then
  if [ -f "$XFR_KEY" ]; then bind_role=primary; else log "AVERTISSEMENT : clé de transfert TSIG absente ($XFR_KEY) : BIND reste sans secondaire"; fi
fi

log "contrôle du contenu déposé"
check_kea "$GEN/kea-dhcp4.conf"
if [ "$MODE" != kea-only ]; then check_named "$GEN/named.conf.options"; check_named "$GEN/named.conf.zones"; fi
shopt -s nullglob
if [ "$MODE" = full ]; then for z in "$GEN"/zones/db.*; do check_zone "$z"; done; fi
ptmp=""; adtmp=""; trap 'rm -rf "${ptmp:-}" "${adtmp:-}"' EXIT
if [ "$MODE" != kea-only ]; then
  # recomposition des « update-policy » et ajout du keytab GSS-TSIG AVANT toute modification : un dépôt refusé ne touche à rien
  [ -d "$STATE" ] || install -d -m 0755 "$STATE"   # ne JAMAIS changer les droits d’un dossier existant : la console (ddiconsole) doit le traverser
  adtmp="$(mktemp -d "$STATE/.ad.XXXXXX")"
  ad_py "$bind_role" "$GEN/named.conf.options" "$GEN/named.conf.zones" "$adtmp/options" "$adtmp/zones" "$BIND_ETC/krb5.keytab" 2>"$adtmp/err" \
    || fail "mises à jour sécurisées refusées : $(tr '\n' ' ' < "$adtmp/err" | cut -c1-200)"
  while IFS= read -r w; do [ -z "$w" ] || log "$w"; done < "$adtmp/err"
  SRC_OPTS="$adtmp/options"; SRC_ZONES="$adtmp/zones"
fi
if [ "$MODE" = promote ]; then
  # Les zones transférées sont stockées par BIND au format binaire (« raw ») avec un journal IXFR : on les convertit en texte, journal appliqué
  # (named-compilezone -j), AVANT toute modification ; une zone illisible fait refuser la promotion (le nœud reste secondaire et continue de servir).
  ptmp="$(mktemp -d "$STATE/.promote.XXXXXX")"
  while IFS=$'\t' read -r zname zfile; do
    [ -n "$zname" ] || continue
    if [ ! -f "$zfile" ]; then log "AVERTISSEMENT : zone $zname jamais transférée ($zfile absent) : elle restera vide jusqu'au prochain déploiement"; continue; fi
    out="$ptmp/$(basename "$zfile")"
    named-compilezone -j -k warn -f raw -F text -o "$out" "$zname" "$zfile" >/dev/null 2>&1 \
      || named-compilezone -j -k warn -f text -F text -o "$out" "$zname" "$zfile" >/dev/null 2>&1 \
      || fail "zone transférée $zname illisible ou invalide : promotion refusée (le nœud reste secondaire)"
    check_zone "$out"
  done < <(sed -nE 's/^zone "([^"]+)" \{ type primary; file "([^"]+)";.*/\1\t\2/p' "$GEN/named.conf.zones")
fi

# ---- Sauvegarde puis installation ----
install -d -m 0750 "$BACKUP"
if [ "$MODE" = full ] || [ "$MODE" = promote ]; then
  rm -rf "$BACKUP/zones"; install -d -m 0750 "$BACKUP/zones"
  for f in "$ZONES"/db.*; do cp -p "$f" "$BACKUP/zones/"; done
fi
rm -f "$BACKUP"/*.prev
for f in "$BIND_ETC/named.conf.options" "$BIND_ETC/named.conf.local" "$BIND_ETC/ddi-xfr-views.key" "$KEA_ETC/kea-dhcp4.conf"; do
  [ "$MODE" != kea-only ] || [ "$(basename "$f")" = kea-dhcp4.conf ] || continue
  [ -f "$f" ] && cp -p "$f" "$BACKUP/$(basename "$f").prev"
done
# Les services ont peut-être déjà relu la NOUVELLE configuration : après avoir remis les anciens fichiers, on leur fait relire l'ancienne.
reload_after_restore() {
  [ -z "${DDI_RELOAD_NOSERVICES:-}" ] || return 0
  if [ "$MODE" != kea-only ]; then systemctl reload named >/dev/null 2>&1 || systemctl restart named >/dev/null 2>&1 || log "BIND n'a pas pu relire l'ancienne configuration"; fi
  if python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1]))["Dhcp4"].get("subnet4") else 1)' "$KEA_ETC/kea-dhcp4.conf" 2>/dev/null; then
    systemctl reload-or-restart kea-dhcp4-server >/dev/null 2>&1 || log "Kea n'a pas pu relire l'ancienne configuration"
  fi
}
restore() {
  ROLLED_BACK=1; log "retour arrière"
  if [ "$MODE" = full ] || [ "$MODE" = promote ]; then
    for f in "$ZONES"/db.*; do rm -f "$f"; done
    for f in "$BACKUP/zones"/db.*; do cp -p "$f" "$ZONES/"; done
  fi
  for p in "$BACKUP"/*.prev; do
    b="$(basename "$p" .prev)"
    case "$b" in kea-dhcp4.conf) cp -p "$p" "$KEA_ETC/$b" ;; *) cp -p "$p" "$BIND_ETC/$b" ;; esac
  done
  # fichier absent avant l'application (première installation de Kea) : on le retire plutôt que de laisser la configuration refusée
  [ -f "$BACKUP/kea-dhcp4.conf.prev" ] || rm -f "$KEA_ETC/kea-dhcp4.conf"
  reload_after_restore
}

if [ "$MODE" = replica ] && [ "$prev_bind_role" = primary ]; then
  # ancien primaire qui redevient secondaire : ses fichiers de zone peuvent porter un numéro de série plus récent que celui du nouveau primaire
  # (mises à jour non transférées avant la panne) ; BIND ne les remplacerait alors jamais. On repart d'un transfert complet : le nouveau primaire fait foi.
  log "ancien primaire : fichiers de zone retirés pour un transfert complet depuis le nouveau primaire"
  for old in "$ZONES"/db.*; do rm -f "$old" "$old.jnl"; done
fi
if [ "$MODE" = promote ]; then
  # zones converties en texte : le journal du secondaire est déjà appliqué, il serait incohérent avec le nouveau fichier
  for z in "$ptmp"/db.*; do install -m 0640 -o bind -g bind "$z" "$ZONES/$(basename "$z")"; rm -f "$ZONES/$(basename "$z").jnl"; done
fi
if [ "$MODE" = full ]; then
  install -d -m 0750 -o bind -g bind "$ZONES"
  new=()
  for z in "$GEN"/zones/db.*; do install -m 0640 -o bind -g bind "$z" "$ZONES/$(basename "$z")"; new+=("$(basename "$z")"); done
  # fichiers de zone retirés de la configuration : suppression des seuls fichiers « db.* » qui ne sont plus déclarés
  for old in "$ZONES"/db.*; do
    b="$(basename "$old")"
    if ! printf '%s\n' "${new[@]:-}" | grep -qxF "$b" && ! grep -qF "\"$ZONES/$b\"" "$GEN/named.conf.zones"; then rm -f "$old" "$old.jnl"; fi
  done
fi
if [ "$MODE" != kea-only ]; then install_named || { restore; fail "transformation BIND du cluster refusée"; }; fi
install -d -m 0755 "$KEA_ETC"
install_kea || { restore; fail "installation de la configuration Kea impossible"; }
verify_kea || { restore; fail "kea-dhcp4 -t a refusé la configuration finale (HA)"; }

if [ "$MODE" != kea-only ]; then
  named-checkconf "$BIND_ETC/named.conf" || { restore; fail "named-checkconf a refusé la configuration installée"; }
fi
if [ "$MODE" = full ]; then
  for z in "$ZONES"/db.*; do
    # shellcheck disable=SC2016
    zname="$(grep -m1 -E '^\$ORIGIN ' "$z" | awk '{print $2}' | sed 's/\.$//')"
    [ -n "$zname" ] || continue
    named-checkzone -k warn "$zname" "$z" >/dev/null || { restore; fail "named-checkzone a refusé la zone $zname"; }
  done
fi

# ---- Rechargement des services (sauté dans les tests sans systemd) ----
if [ -z "${DDI_RELOAD_NOSERVICES:-}" ]; then
  if [ "$MODE" != kea-only ]; then
    if ! systemctl reload named; then systemctl restart named || { restore; fail "BIND ne redémarre pas"; }; fi
  fi
  if python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1]))["Dhcp4"].get("subnet4") else 1)' "$KEA_ETC/kea-dhcp4.conf"; then
    systemctl enable kea-dhcp4-server >/dev/null 2>&1
    if ! systemctl reload-or-restart kea-dhcp4-server; then restore; fail "Kea ne démarre pas avec la nouvelle configuration"; fi
  else
    systemctl disable --now kea-dhcp4-server >/dev/null 2>&1 || true   # aucune étendue : le service reste arrêté
  fi
fi
if [ "$MODE" != kea-only ]; then printf '%s\n' "$bind_role" > "$STATE/bind-role"; fi
case "$MODE" in
  promote) date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/last-reload"; log "ce nœud est maintenant le primaire BIND"; status 1 "nœud promu : BIND primaire, zones transférées conservées" ;;
  full) date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/last-reload"; log "configuration appliquée"; status 1 "configuration appliquée" ;;
  replica) date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/last-reload"; log "configuration appliquée (réplica)"; status 1 "configuration appliquée (nœud secondaire : DHCP et DNS)" ;;
  kea-only) date -u +%Y-%m-%dT%H:%M:%SZ > "$STATE/last-reload-kea"; log "configuration Kea appliquée"; status 1 "configuration Kea appliquée (nœud de données)" ;;
esac
