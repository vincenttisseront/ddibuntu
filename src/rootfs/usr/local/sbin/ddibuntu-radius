#!/bin/bash
# ddibuntu-radius — service RADIUS (FreeRADIUS) de l'appliance, piloté par la console web (sans privilège).
# Frontière de privilèges : la console dépose .radius-request et radius-clients.conf ; ICI, root revalide le fichier ligne à ligne
# (aucune directive libre), installe une arborescence FreeRADIUS dont DDI-Buntu est seul propriétaire (/etc/ddibuntu/radius, jamais
# la configuration du paquet), la contrôle (freeradius -Cx), redémarre le service, n'ouvre le pare-feu qu'aux clients déclarés et
# restaure l'ancienne arborescence en cas d'échec.
# EAP-TLS (0.13.2) : la console dépose aussi un dossier radius-pki/ (autorités de confiance, certificat et clé du serveur, CRL) ; root le copie
# dans un dossier privé, le revalide avec openssl (chaîne, usage, clé, dates, signature des CRL), installe CE qui a été validé, jamais l'original.
# Règles d'accès (0.13.3) : la console dépose des DONNÉES (radius-authz/ : rules.json, ldap.json, ldap-ca.pem) ; root les valide champ par champ et
# écrit lui-même le module LDAP et la décision (unlang). Aucun texte de configuration de la console n'est jamais repris.
set -euo pipefail
umask 027

DDI_LIBDIR="${DDI_LIBDIR:-/usr/local/lib/ddibuntu}"
# shellcheck source=/dev/null
. "$DDI_LIBDIR/common.sh"

GEN="${DDI_GENERATED_DIR:-/var/lib/ddibuntu/generated}"
RDIR="${DDI_RADIUS_DIR:-/etc/ddibuntu/radius}"          # arborescence gérée (propriétaire root, groupe freerad)
STOCK="${DDI_RADIUS_STOCK:-/etc/freeradius/3.0}"        # modules du paquet (liens symboliques seulement, jamais modifiés)
RUN="${DDI_RUN_DIR:-/run/ddibuntu}"
STATE="${DDI_STATE_DIR:-/var/lib/ddibuntu}"
RADIUSD="${DDI_RADIUSD:-/usr/sbin/freeradius}"
SYSCTL="${DDI_RADIUS_SYSTEMCTL:-systemctl}"
JOURNALCTL="${DDI_RADIUS_JOURNALCTL:-journalctl}"
FW_BIN="${DDI_FW_BIN:-/usr/local/sbin/ddibuntu-fw}"
GROUP="${DDI_RADIUS_GROUP:-freerad}"
AUTHLOG_DIR="${DDI_RADIUS_AUTHLOG_DIR:-/var/log/ddibuntu-radius}"   # journal des authentifications : écrit par FreeRADIUS, lu par la console (groupe ddiconsole) — jamais le reste de /var/log/freeradius
CONSOLE_GROUP="${DDI_CONSOLE_GROUP:-ddiconsole}"
SERVICE="freeradius.service"
BACKUP="$STATE/radius-backup"
MODULES="always attr_filter preprocess expr"            # modules du paquet réellement utilisés par le site (le module eap est généré, pas celui du paquet) ; expr : %{escape:} du journal et règles d'accès
LDAP_SO="${DDI_RADIUS_LDAP_SO:-/usr/lib/freeradius/rlm_ldap.so}"   # module LDAP : paquet freeradius-ldap (séparé du paquet freeradius)
REST_SO="${DDI_RADIUS_REST_SO:-/usr/lib/freeradius/rlm_rest.so}"   # 0.17.0 : module REST (fournisseur MFA) : paquet freeradius-rest (séparé du paquet freeradius)
MAX_CLIENTS_BYTES=1048576
# 0.16.0 : identifiant + mot de passe. PEAP-MSCHAPv2 exige une jonction au domaine (winbind + ntlm_auth) ; l'état de Samba (secrets.tdb) y reste entre deux déploiements.
WBSTATE="${DDI_RADIUS_WB_STATE:-$STATE/radius-winbind}"
NTLM_AUTH="${DDI_NTLM_AUTH:-/usr/bin/ntlm_auth}"
NET_BIN="${DDI_NET_BIN:-/usr/bin/net}"
WBSERVICE="ddibuntu-radius-winbind.service"
CLCONF="${DDI_CLUSTER_CONF:-/etc/ddibuntu-cluster/cluster.conf}"   # 0.15.0 : présent = ce nœud fait partie d'un cluster
CLUSTER_CMD="${DDI_CLUSTER_CMD:-/usr/local/sbin/ddibuntu-cluster}"

usage() {
  cat <<'USAGE'
Usage : ddibuntu-radius <commande>
  apply FICHIER [PKI [RÈGLES]]  installe la configuration (clients validés, EAP-TLS si un dossier PKI est fourni, règles d'accès si un dossier RÈGLES est fourni), la contrôle et (re)démarre le service
  stop            arrête et désactive le service, referme le pare-feu
  status          publie l'état (/run/ddibuntu/radius-status.json)
  request         traite la demande déposée par la console (.radius-request + radius-clients.conf)
  align leader|replica  cluster : RADIUS ne tourne que sur le leader ; sur un secondaire, arrête le service (appelé par « ddibuntu-cluster follow »)
  crl             installe les CRL déposées (radius-pki/crl) sans redémarrer le service
  check FICHIER   valide un fichier de clients (sans rien installer) ; affiche les réseaux à ouvrir au pare-feu
  check-pki DOSSIER  valide un dossier PKI (sans rien installer)
  check-authz DOSSIER FICHIER  valide un dossier de règles d'accès (avec le fichier de clients correspondant) et affiche la configuration générée
  join            joint cette appliance au domaine (PEAP-MSCHAPv2) : demande déposée par la console (radius-join/join.json), compte utilisé une fois, jamais conservé
  leave           retire la jonction de CE nœud (PEAP-MSCHAPv2 cesse de fonctionner ici)
USAGE
}

log() { ddi_log "radius: $*"; printf 'ddibuntu-radius: %s\n' "$*" >&2; }

# ---- Publication (sans secret, lisible par la console) ----
publish() {   # $1 = nom de fichier, $2 = JSON
  install -d -m 0755 "$RUN" 2>/dev/null || return 0
  local t; t="$(mktemp "$RUN/.radius.XXXXXX")" || return 0
  printf '%s\n' "$2" > "$t"; chmod 0644 "$t"; mv -f "$t" "$RUN/$1"
}
publish_result() {   # $1 = action, $2 = ok (true|false), $3 = message
  publish radius-result.json "$(A="$1" O="$2" M="$3" python3 -c 'import json,os,time; print(json.dumps({"at": int(time.time()), "action": os.environ["A"], "ok": os.environ["O"] == "true", "message": os.environ["M"][:300]}, ensure_ascii=False))')"
}
svc_state() { "$SYSCTL" "$1" --quiet "$SERVICE" >/dev/null 2>&1 && echo true || echo false; }
# État d'EAP-TLS installé (sans secret) : certificat du serveur, nombre d'autorités, CRL et leur échéance.
pki_info() {
  RDIR="$RDIR" python3 - <<'PY' 2>/dev/null || echo '{"enabled": false}'
import calendar, json, os, re, subprocess, time
r = os.environ["RDIR"]; c = os.path.join(r, "certs")
def ossl(*a):
    p = subprocess.run(["openssl", *a], capture_output=True, timeout=20, env=dict(os.environ, LC_ALL="C"))
    return p.returncode, p.stdout.decode("utf-8", "replace")
def when(txt, key):
    m = re.search(key + r"=(\w{3}) +(\d+) (\d\d):(\d\d):(\d\d) (\d{4}) GMT", txt)
    if not m: return None
    mon = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"].index(m.group(1)) + 1
    return calendar.timegm((int(m.group(6)), mon, int(m.group(2)), int(m.group(3)), int(m.group(4)), int(m.group(5))))
out = {"enabled": False}
sp = os.path.join(c, "server.pem")
if os.path.isfile(sp) and os.path.isfile(os.path.join(r, "mods-enabled", "eap")):
    rc, t = ossl("x509", "-in", sp, "-noout", "-subject", "-enddate", "-nameopt", "RFC2253")
    m = re.search(r"^subject=(.*)$", t, re.M)
    out = {"enabled": True, "server": {"subject": (m.group(1).strip() if m else "")[:300], "not_after": when(t, "notAfter")}, "cas": 0, "crls": [],
           "check_crl": "check_crl = yes" in open(os.path.join(r, "mods-enabled", "eap"), encoding="utf-8", errors="replace").read()}
    try: out["cas"] = open(os.path.join(c, "ca.pem")).read().count("BEGIN CERTIFICATE")
    except OSError: pass
    d = os.path.join(c, "crl")
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if not f.endswith(".pem"): continue
        rc, t = ossl("crl", "-in", os.path.join(d, f), "-noout", "-issuer", "-nextupdate", "-nameopt", "RFC2253")
        m = re.search(r"^issuer=(.*)$", t, re.M)
        out["crls"].append({"issuer": (m.group(1).strip() if m else "")[:300], "next_update": when(t, "nextUpdate")})
print(json.dumps(out))
PY
}
# État des règles d'accès installées (sans secret) : nombre de règles et serveurs d'annuaire.
authz_info() {
  RDIR="$RDIR" python3 - <<'PY' 2>/dev/null || echo '{"enabled": false}'
import json, os, re
r = os.environ["RDIR"]; ldap = os.path.join(r, "mods-enabled", "ldap"); site = os.path.join(r, "sites-available", "ddibuntu")
if not (os.path.isfile(ldap) and os.path.isfile(site)):
    print(json.dumps({"enabled": False})); raise SystemExit(0)
servers = re.findall(r'^\tserver = "([^"]+)"$', open(ldap, encoding="utf-8", errors="replace").read(), re.M)
n = len(re.findall(r"^\t\t# règle \d+ :", open(site, encoding="utf-8", errors="replace").read(), re.M))
print(json.dumps({"enabled": True, "rules": n, "servers": servers[:5]}))
PY
}
cmd_status() {
  local version="" installed=false configured=false nclients=0 ldapmod=false restmod=false
  [[ -f "$LDAP_SO" ]] && ldapmod=true
  [[ -f "$REST_SO" ]] && restmod=true
  if [[ -x "$RADIUSD" ]]; then installed=true; version="$("$RADIUSD" -v 2>/dev/null | sed -n 's/^radiusd: FreeRADIUS Version \([0-9][0-9.]*\).*/\1/p' | head -n1)" || version=""; fi
  if [[ -f "$RDIR/clients.conf" ]]; then configured=true; nclients="$(grep -c '^client "' "$RDIR/clients.conf" || true)"; nclients=$((nclients > 0 ? nclients - 1 : 0)); fi   # sans le client d'essai local
  publish radius-status.json "$(V="$version" I="$installed" C="$configured" N="$nclients" A="$(svc_state is-active)" E="$(svc_state is-enabled)" P="$(pki_info)" Z="$(authz_info)" M="$ldapmod" R="$restmod" W="$(winbind_info)" python3 -c '
import json, os, time
b = lambda k: os.environ[k] == "true"
print(json.dumps({"at": int(time.time()), "installed": b("I"), "version": os.environ["V"], "configured": b("C"), "active": b("A"), "enabled": b("E"), "clients": int(os.environ["N"]), "ports": [1812, 1813], "eap": json.loads(os.environ["P"]), "authz": json.loads(os.environ["Z"]), "ldap_module": b("M"), "rest_module": b("R"), "winbind": json.loads(os.environ["W"])}))')"
}

# ---- Validation du fichier déposé par la console : uniquement des blocs « client » de forme imposée ----
# Sortie : un réseau normalisé par ligne (clients à ouvrir au pare-feu, sans le client d'essai local).
validate_clients() {
  python3 - "$1" <<'PY'
import ipaddress, re, sys
NAME = re.compile(r'^[a-z][a-z0-9-]{0,40}$')
SECRET = re.compile(r'^[A-Za-z0-9._~+=:@,;()!*-]{16,128}$')
def die(m):
    sys.stderr.write("clients RADIUS refusés : %s\n" % m); sys.exit(1)
try:
    lines = open(sys.argv[1], encoding="utf-8").read().split("\n")
except Exception:
    die("fichier illisible")
seen, nets, selftest = set(), [], False
cur = None
OPEN = re.compile(r'^client "([^"]*)" \{$')
KEYS = [("ipaddr", re.compile(r'^ipaddr = ([0-9./]+)$')), ("ipv6addr", re.compile(r'^ipv6addr = ([0-9a-f:./]+)$')),
        ("secret", re.compile(r'^secret = "([^"]*)"$')), ("shortname", re.compile(r'^shortname = ([a-z0-9-]+)$')),
        ("require_message_authenticator", re.compile(r'^require_message_authenticator = (yes)$')), ("nas_type", re.compile(r'^nas_type = (other)$')),
        ("virtual_server", re.compile(r'^virtual_server = (ddibuntu-mfa)$'))]   # 0.17.0 : seule valeur admise ; le client est alors traité par le serveur MFA (PAP + fournisseur externe)
for i, raw in enumerate(lines, 1):
    line = raw.strip()
    if cur is None:
        if not line or line.startswith("#"): continue
        m = OPEN.match(line)
        if not m: die("ligne %d inattendue" % i)
        name = m.group(1)
        if not NAME.match(name): die("nom de client invalide (ligne %d)" % i)
        if name in seen: die("nom de client en double : %s" % name)
        seen.add(name); cur = {"name": name}
        continue
    if line == "}":
        for k in ("addr", "secret", "shortname", "require_message_authenticator", "nas_type"):
            if k not in cur: die("client %s : directive %s manquante" % (cur["name"], k))
        if cur["shortname"] != cur["name"]: die("client %s : shortname différent du nom" % cur["name"])
        a = cur["addr"]
        if cur["name"] == "ddi-selftest":
            if "virtual_server" in cur: die("le client d'essai ne peut pas être un client MFA")
            if str(a) != "127.0.0.1/32": die("le client d'essai doit être exactement 127.0.0.1")
            selftest = True
        else:
            if a.is_loopback or a.is_multicast or a.is_unspecified or a.is_link_local: die("client %s : adresse réservée" % cur["name"])
            if a.version == 4 and a.prefixlen < 16: die("client %s : réseau trop large (/16 au plus large en IPv4)" % cur["name"])
            if a.version == 6 and a.prefixlen < 48: die("client %s : réseau trop large (/48 au plus large en IPv6)" % cur["name"])
            nets.append(str(a))
        cur = None
        continue
    ok = False
    for key, rx in KEYS:
        m = rx.match(line)
        if not m: continue
        ok = True
        if key in ("ipaddr", "ipv6addr"):
            if "addr" in cur: die("client %s : adresse en double" % cur["name"])
            try:
                a = ipaddress.ip_network(m.group(1), strict=True)
            except ValueError:
                die("client %s : adresse invalide" % cur["name"])
            if (key == "ipaddr") != (a.version == 4): die("client %s : famille d'adresse incohérente" % cur["name"])
            cur["addr"] = a
        elif key == "secret":
            if "secret" in cur: die("client %s : secret en double" % cur["name"])
            if not SECRET.match(m.group(1)): die("client %s : secret refusé (16 à 128 caractères autorisés)" % cur["name"])
            cur["secret"] = True
        else:
            if key in cur: die("client %s : directive %s en double" % (cur["name"], key))
            cur[key] = m.group(1)
        break
    if not ok: die("client %s : directive inattendue (ligne %d)" % (cur["name"], i))
if cur is not None: die("bloc client non fermé")
if not selftest: die("client d'essai local absent")
if len(seen) > 2000: die("trop de clients")
print("\n".join(nets))
PY
}

# ---- Validation du dossier PKI déposé par la console (openssl) ----
# validate_pki SOURCE INSTANTANÉ [crl AUTORITÉS_INSTALLÉES CHECK_CRL] : copie ce qui est valide dans INSTANTANÉ (dossier privé de root) ; l'installation
# se fait depuis cette copie, jamais depuis la source (que la console peut encore modifier). Sortie : « checkCrl=true|false » puis « warn: … ».
validate_pki() {
  python3 - "$@" <<'PY'
import atexit, datetime, json, os, re, shutil, subprocess, sys, tempfile
src, snap = sys.argv[1], sys.argv[2]
mode = sys.argv[3] if len(sys.argv) > 3 else "full"
def die(m):
    sys.stderr.write("PKI RADIUS refusée : %s\n" % m); sys.exit(1)
ENV = dict(os.environ, LC_ALL="C")
tmp = tempfile.mkdtemp(prefix="ddi-pki-"); atexit.register(shutil.rmtree, tmp, True)
def ossl(*a, inp=None):
    try: p = subprocess.run(["openssl", *a], input=inp, capture_output=True, timeout=30, env=ENV)
    except Exception: die("openssl indisponible")
    return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")
def read(rel, limit, required=True):
    p = os.path.join(src, rel)
    if os.path.islink(p) or not os.path.isfile(p):
        if required: die("%s absent" % rel)
        return None
    if os.path.getsize(p) > limit: die("%s trop volumineux" % rel)
    try: return open(p, "rb").read().decode("ascii")
    except UnicodeDecodeError: die("%s : caractères non PEM" % rel)
def wr(name, txt):
    f = os.path.join(tmp, name); open(f, "w").write(txt); return f
CERT = re.compile(r"-----BEGIN CERTIFICATE-----\r?\n[A-Za-z0-9+/=\r\n]+?-----END CERTIFICATE-----\r?\n?")
CRLRX = re.compile(r"-----BEGIN X509 CRL-----\r?\n[A-Za-z0-9+/=\r\n]+?-----END X509 CRL-----\r?\n?")
def only(rx, txt, what):
    blocks = rx.findall(txt)
    if not blocks or rx.sub("", txt).strip(): die("%s : seul du PEM attendu (certificats ou CRL), rien d'autre" % what)
    return blocks
def when(txt, key):
    m = re.search(key + r"=(\w{3}) +(\d+) (\d\d):(\d\d):(\d\d) (\d{4}) GMT", txt)
    if not m: return None
    return datetime.datetime.strptime("%s %s %s:%s:%s %s" % m.groups(), "%b %d %H:%M:%S %Y").replace(tzinfo=datetime.timezone.utc)
now = datetime.datetime.now(datetime.timezone.utc)
if os.path.islink(src) or not os.path.isdir(src): die("dossier de dépôt absent")
if mode == "crl":
    ca_txt = open(sys.argv[4], encoding="ascii").read(); check_crl = sys.argv[5] == "true"
else:
    try: opts = json.loads(read("pki.json", 4096))
    except ValueError: die("pki.json illisible")
    if not isinstance(opts, dict) or not isinstance(opts.get("checkCrl"), bool): die("pki.json : checkCrl absent")
    check_crl = opts["checkCrl"]; ca_txt = read("ca.pem", 262144)
ca_blocks = only(CERT, ca_txt, "ca.pem")
if len(ca_blocks) > 32: die("trop d'autorités de confiance (32 au plus)")
cas = []
for i, b in enumerate(ca_blocks):
    f = wr("ca%d.pem" % i, b)
    rc, out, _ = ossl("x509", "-in", f, "-noout", "-subject", "-issuer", "-nameopt", "RFC2253", "-ext", "basicConstraints", "-checkend", "0")
    subj = re.search(r"^subject=(.*)$", out, re.M); iss = re.search(r"^issuer=(.*)$", out, re.M)
    if rc != 0 and "will expire" in out: die("autorité expirée : %s" % (subj.group(1).strip() if subj else "?"))
    if rc != 0 or not subj or not iss: die("certificat d'autorité illisible (n° %d)" % (i + 1))
    if "CA:TRUE" not in out: die("%s n'est pas une autorité (CA:TRUE absent)" % subj.group(1).strip())
    cas.append({"f": f, "subject": subj.group(1).strip(), "issuer": iss.group(1).strip(), "pem": b})
for c in cas: c["root"] = c["subject"] == c["issuer"]
roots = [c for c in cas if c["root"]]
if not roots: die("aucune racine (autorité autosignée) dans la chaîne de confiance")
roots_f = wr("roots.pem", "".join(c["pem"] for c in roots)); all_f = wr("allcas.pem", "".join(c["pem"] for c in cas))
for c in cas:
    rc, out, err = ossl("verify", "-CAfile", roots_f, "-untrusted", all_f, "-check_ss_sig", c["f"])
    if rc != 0 or ": OK" not in out: die("%s : chaîne incomplète ou invalide jusqu'à une racine de la liste" % c["subject"])
# autorités qui émettent les certificats clients = feuilles de l'arbre (aucune autre autorité de la liste ne leur est subordonnée)
issuing = [c for c in cas if not any((o is not c) and (not o["root"]) and o["issuer"] == c["subject"] for o in cas)]
# CRL
crls = []
d = os.path.join(src, "crl")
names = sorted(os.listdir(d)) if os.path.isdir(d) and not os.path.islink(d) else []
if len(names) > 64: die("trop de CRL (64 au plus)")
for n in names:
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}\.pem", n): die("nom de CRL refusé : %s" % n)
    txt = read(os.path.join("crl", n), 12 * 1024 * 1024)
    only(CRLRX, txt, "CRL %s" % n)
    if len(CRLRX.findall(txt)) != 1: die("CRL %s : un seul bloc attendu" % n)
    f = wr("crl-%s" % n, txt)
    rc, out, err = ossl("crl", "-in", f, "-noout", "-issuer", "-nextupdate", "-lastupdate", "-nameopt", "RFC2253", "-CAfile", all_f)
    iss = re.search(r"^issuer=(.*)$", out, re.M)
    if rc != 0 or "verify OK" not in (out + err) or not iss: die("CRL %s : signature non vérifiée par une autorité de la liste" % n)
    nu = when(out, "nextUpdate")
    if nu is None: die("CRL %s : date de prochaine mise à jour absente" % n)
    if nu <= now: die("CRL %s expirée depuis le %s (FreeRADIUS refuserait alors tous les certificats)" % (n, nu.strftime("%Y-%m-%d %H:%M")))
    lu = when(out, "lastUpdate")
    if lu is not None and (lu - now).total_seconds() > 60: die("CRL %s émise dans le futur (%s) : vérifiez l'heure de ce nœud et celle de l'autorité (OpenSSL refuserait tous les certificats jusque-là)" % (n, lu.strftime("%Y-%m-%d %H:%M")))
    crls.append({"name": n, "issuer": iss.group(1).strip(), "txt": txt, "next": nu})
if check_crl:
    for c in issuing:
        if not any(k["issuer"] == c["subject"] for k in crls): die("CRL manquante pour l'autorité %s (vérification des révocations activée)" % c["subject"])
warns = []
for k in crls:
    if (k["next"] - now).total_seconds() < 86400: warns.append("la CRL de %s expire dans moins de 24 h" % k["issuer"])
server_pem = key_txt = None
if mode == "full":
    chain = only(CERT, read("server.pem", 65536), "server.pem")
    if len(chain) > 10: die("chaîne du serveur trop longue")
    sp = wr("server.pem", "".join(chain)); leaf = wr("leaf.pem", chain[0])
    rc, out, err = ossl("verify", "-CAfile", roots_f, "-untrusted", sp, "-purpose", "sslserver", leaf)
    if rc != 0 or ": OK" not in out:
        reason = re.search(r"error \d+ at \d+ depth lookup: (.*)", out + err)
        die("certificat du serveur refusé : %s (la chaîne envoyée aux clients doit contenir les autorités intermédiaires)" % (reason.group(1) if reason else "chaîne ou usage invalide"))
    rc, out, _ = ossl("x509", "-in", leaf, "-noout", "-enddate", "-checkend", str(30 * 86400))
    if "will expire" in out: warns.append("le certificat du serveur expire dans moins de 30 jours")
    key_txt = read("server.key", 16384)
    if "ENCRYPTED" in key_txt or len(re.findall(r"-----BEGIN (?:RSA |EC )?PRIVATE KEY-----", key_txt)) != 1 or not re.fullmatch(r"(?s)\s*-----BEGIN (?:RSA |EC )?PRIVATE KEY-----[A-Za-z0-9+/=\r\n]+-----END (?:RSA |EC )?PRIVATE KEY-----\s*", key_txt):
        die("server.key : une seule clé privée PEM non chiffrée est attendue")
    kf = wr("server.key", key_txt)
    rc, out, _ = ossl("pkey", "-in", kf, "-noout", "-text")
    if rc != 0: die("clé privée illisible")
    m = re.search(r"Private-Key: \((\d+) bit", out)
    if "modulus:" in out and (not m or int(m.group(1)) < 2048): die("clé RSA de moins de 2048 bits refusée")
    rc1, pub_c, _ = ossl("x509", "-in", leaf, "-noout", "-pubkey"); rc2, pub_k, _ = ossl("pkey", "-in", kf, "-pubout")
    if rc1 != 0 or rc2 != 0 or pub_c.strip() != pub_k.strip(): die("la clé privée ne correspond pas au certificat du serveur")
    server_pem = "".join(chain)
# instantané : uniquement ce qui vient d'être validé
os.makedirs(os.path.join(snap, "crl"), mode=0o700, exist_ok=True)
def put(rel, txt, mode_=0o600):
    f = os.path.join(snap, rel); fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode_)
    with os.fdopen(fd, "w") as h: h.write(txt)
put("ca.pem", "".join(c["pem"] for c in cas))
for k in crls: put(os.path.join("crl", k["name"]), k["txt"])
if mode == "full": put("server.pem", server_pem); put("server.key", key_txt)
print("checkCrl=%s" % ("true" if check_crl else "false"))
for w in warns: print("warn: " + w)
PY
}

# ---- Règles d'accès (0.13.3) : validation du dossier déposé par la console ET génération de la configuration ----
# La console dépose des DONNÉES (rules.json, ldap.json, ldap-ca.pem), jamais de configuration FreeRADIUS : root valide chaque champ avec des
# listes blanches strictes, puis écrit LUI-MÊME le module LDAP et le serveur de décision (unlang) dans l'instantané. Aucun texte de la console n'est
# repris tel quel dans une directive, et aucun caractère susceptible d'être interprété (guillemet, « $ », « % », « { », saut de ligne) n'y entre.
# validate_authz SOURCE INSTANTANÉ FICHIER_CLIENTS : écrit INSTANTANÉ/{ldap.mod,site.conf,ldap-ca.pem}. Sortie : « rules=N servers=URL,URL ».
validate_authz() {
  DDI_WB_STATE="$WBSTATE" DDI_NTLM_AUTH="$NTLM_AUTH" python3 - "$@" <<'PY'
import json, os, re, subprocess, sys, tempfile, shutil, atexit
src, snap, clients_file = sys.argv[1], sys.argv[2], sys.argv[3]
def die(m):
    sys.stderr.write("règles d'accès refusées : %s\n" % m); sys.exit(1)
def read(rel, limit, required=True):
    p = os.path.join(src, rel)
    if os.path.islink(p) or not os.path.isfile(p):
        if required: die("%s absent" % rel)
        return None
    if os.path.getsize(p) > limit: die("%s trop volumineux" % rel)
    try: return open(p, "rb").read().decode("utf-8")
    except UnicodeDecodeError: die("%s : UTF-8 attendu" % rel)
if os.path.islink(src) or not os.path.isdir(src): die("dossier de dépôt absent")
# seuls les trois fichiers que dépose la console sont admis (rien d'autre n'est lu ni ne doit survivre dans le dépôt)
extra = sorted(set(os.listdir(src)) - {"rules.json", "ldap.json", "ldap-ca.pem", "auth.json", "mfa.json", "mfa-ca.pem"})
if extra: die("fichier inattendu dans le dépôt : %s" % extra[0][:40].encode("ascii", "replace").decode())
try: rules_doc = json.loads(read("rules.json", 4 * 1024 * 1024))
except ValueError: die("rules.json illisible")
try: ldap_doc = json.loads(read("ldap.json", 65536))
except ValueError: die("ldap.json illisible")
ca_txt = read("ldap-ca.pem", 65536, required=False)
auth_txt = read("auth.json", 4096, required=False)
mfa_txt = read("mfa.json", 16384, required=False)
mfa_ca_txt = read("mfa-ca.pem", 65536, required=False)

CTRL = re.compile(r"[\x00-\x1f\x7f]")
def text(v, what, lo, hi, rx=None):
    if not isinstance(v, str) or not (lo <= len(v) <= hi) or CTRL.search(v): die("%s : valeur invalide" % what)
    if rx is not None and not rx.fullmatch(v): die("%s : caractères refusés" % what)
    return v
def integer(v, what, lo, hi):
    if isinstance(v, bool) or not isinstance(v, int) or not (lo <= v <= hi): die("%s : entier entre %d et %d attendu" % (what, lo, hi))
    return v
# FreeRADIUS interprète « ${…} », « $ENV{…} » et « $(…) » dans une chaîne de configuration, même entre guillemets
def noexpand(v, what):
    if re.search(r"\$(\{|ENV|\()", v): die("%s : la séquence « $ » suivie de « { », « ENV » ou « ( » n'est pas prise en charge" % what)
    return v
dq = lambda s: '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'      # chaîne de configuration (module)
sq = lambda s: "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"      # littéral unlang (aucune expansion)

# ---- annuaire ----
if not isinstance(ldap_doc, dict): die("ldap.json : objet attendu")
if set(ldap_doc) - {"urls", "baseDn", "bindDn", "bindPassword", "tlsRejectUnauthorized"}: die("ldap.json : champ inconnu")
urls = ldap_doc.get("urls")
if not isinstance(urls, list) or not (1 <= len(urls) <= 5): die("ldap.json : 1 à 5 serveurs attendus")
URL = re.compile(r"ldaps://[A-Za-z0-9._-]{1,253}(:[0-9]{1,5})?")
for u in urls:
    text(u, "serveur LDAP", 9, 280, URL)
if len(set(urls)) != len(urls): die("serveurs LDAP en double")
BASE = re.compile(r"[^\"$%{}`\\]{3,500}")
base_dn = text(ldap_doc.get("baseDn"), "base DN", 3, 500, BASE)
if "=" not in base_dn: die("base DN invalide")
bind_dn = noexpand(text(ldap_doc.get("bindDn"), "compte de liaison", 1, 500), "compte de liaison")
bind_pw = noexpand(text(ldap_doc.get("bindPassword"), "mot de passe de liaison", 1, 200), "mot de passe de liaison")
reject_unauth = ldap_doc.get("tlsRejectUnauthorized")
if not isinstance(reject_unauth, bool): die("ldap.json : tlsRejectUnauthorized booléen attendu")
ca_ok = False
if ca_txt is not None:
    CERT = re.compile(r"-----BEGIN CERTIFICATE-----\r?\n[A-Za-z0-9+/=\r\n]+?-----END CERTIFICATE-----\r?\n?")
    blocks = CERT.findall(ca_txt)
    if not blocks or CERT.sub("", ca_txt).strip() or len(blocks) > 10: die("ldap-ca.pem : 1 à 10 certificats PEM attendus, rien d'autre")
    tmp = tempfile.mkdtemp(prefix="ddi-ldapca-"); atexit.register(shutil.rmtree, tmp, True)
    for i, b in enumerate(blocks):
        f = os.path.join(tmp, "c%d.pem" % i); open(f, "w").write(b)
        p = subprocess.run(["openssl", "x509", "-in", f, "-noout", "-subject"], capture_output=True, timeout=20)
        if p.returncode != 0: die("ldap-ca.pem : certificat illisible (n° %d)" % (i + 1))
    ca_ok = True

# ---- méthodes par identifiant et mot de passe (0.16.0) : absent = EAP-TLS seulement ----
WBSTATE = os.environ.get("DDI_WB_STATE", "")
NTLM_AUTH = os.environ.get("DDI_NTLM_AUTH", "/usr/bin/ntlm_auth")
NB = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,14}")
auth_doc = {}
if auth_txt is not None:
    try: auth_doc = json.loads(auth_txt)
    except ValueError: die("auth.json illisible")
    if not isinstance(auth_doc, dict) or set(auth_doc) - {"peap", "ttls", "netbios"}: die("auth.json : champ inconnu")
    for k in ("peap", "ttls"):
        if not isinstance(auth_doc.get(k, False), bool): die("auth.json : %s booléen attendu" % k)
    if "netbios" in auth_doc and auth_doc["netbios"] != "": text(auth_doc["netbios"], "nom NetBIOS", 1, 15, NB)
joined = {}
if WBSTATE and os.path.isfile(os.path.join(WBSTATE, "joined.json")) and not os.path.islink(os.path.join(WBSTATE, "joined.json")):
    try: joined = json.load(open(os.path.join(WBSTATE, "joined.json")))
    except ValueError: joined = {}
    if not isinstance(joined, dict) or not NB.fullmatch(str(joined.get("netbios", ""))): joined = {}
netbios = joined.get("netbios") or auth_doc.get("netbios") or ""   # le domaine rejoint fait foi (ntlm_auth --domain) : un autre nom saisi dans la console ne peut que casser PEAP
want_peap, ttls_on = bool(auth_doc.get("peap")), bool(auth_doc.get("ttls"))
peap_on = want_peap and bool(joined)
notes = []
if want_peap and not joined: notes.append("warn: PEAP-MSCHAPv2 demandé mais cette appliance n'est pas jointe au domaine : méthode non activée")
if (peap_on or ttls_on) and not netbios: notes.append("warn: nom NetBIOS du domaine non renseigné : les identifiants « DOMAINE\\compte » sont refusés")

# ---- fournisseur MFA (0.17.0) : vérifie « mot de passe + code à usage unique » pour les clients marqués MFA ; absent = aucun client MFA ----
FIELD = re.compile(r"[A-Za-z][A-Za-z0-9_.-]{0,39}")
OAUTH_ID = re.compile(r"[A-Za-z0-9._~-]{1,200}")      # jeu de caractères sans encodage : la valeur est écrite telle quelle dans le corps du formulaire
OAUTH_SECRET = re.compile(r"[A-Za-z0-9._~-]{0,512}")
EXTRA_VAL = re.compile(r"[A-Za-z0-9 ._~:/@-]{0,200}")
TOKEN_URL = re.compile(r"https://(?P<host>[A-Za-z0-9._-]{1,253})(?::(?P<port>[0-9]{1,5}))?(?P<path>/[A-Za-z0-9._~/:@-]{0,300})?")
mfa = None
if mfa_txt is not None:
    try: mfa_doc = json.loads(mfa_txt)
    except ValueError: die("mfa.json illisible")
    if not isinstance(mfa_doc, dict) or set(mfa_doc) - {"type", "tokenUrl", "clientId", "clientSecret", "fields", "identity", "otpDigits", "extra", "timeoutSec", "tlsVerify"}: die("mfa.json : champ inconnu")
    if mfa_doc.get("type") != "oauth2_password": die("mfa.json : type de fournisseur non pris en charge")
    mu = TOKEN_URL.fullmatch(text(mfa_doc.get("tokenUrl"), "adresse du fournisseur MFA", 9, 400))
    if not mu: die("adresse du fournisseur MFA : https://hôte[:port]/chemin attendu (aucun paramètre dans l'adresse)")
    if mu.group("port") is not None and not (1 <= int(mu.group("port")) <= 65535): die("adresse du fournisseur MFA : port invalide")
    cid = text(mfa_doc.get("clientId"), "identifiant client du fournisseur MFA", 1, 200, OAUTH_ID)
    csec = text(mfa_doc.get("clientSecret", ""), "secret client du fournisseur MFA", 0, 512, OAUTH_SECRET)
    flds = mfa_doc.get("fields", {})
    if not isinstance(flds, dict) or set(flds) - {"identity", "password", "otp"}: die("mfa.json : champs de formulaire invalides")
    f_id, f_pw, f_otp = (text(flds.get(k, d), "nom de champ " + k, 1, 40, FIELD) for k, d in (("identity", "username"), ("password", "password"), ("otp", "totp")))
    if len({f_id, f_pw, f_otp}) != 3 or {f_id, f_pw, f_otp} & {"grant_type", "client_id", "client_secret"}: die("mfa.json : noms de champs en double ou réservés")
    ident = mfa_doc.get("identity", "typed")
    if ident not in ("typed", "account"): die("mfa.json : identity doit valoir typed ou account")
    digits = integer(mfa_doc.get("otpDigits", 6), "nombre de chiffres du code", 6, 8)
    if digits not in (6, 8): die("mfa.json : le code compte 6 ou 8 chiffres")
    mto = integer(mfa_doc.get("timeoutSec", 5), "délai du fournisseur MFA", 2, 15)
    if not isinstance(mfa_doc.get("tlsVerify"), bool): die("mfa.json : tlsVerify booléen attendu")
    extra_p = mfa_doc.get("extra", [])
    if not isinstance(extra_p, list) or len(extra_p) > 5: die("mfa.json : 5 paramètres supplémentaires au plus")
    taken = {"grant_type", "client_id", "client_secret", f_id, f_pw, f_otp}
    for e in extra_p:
        if not isinstance(e, dict) or set(e) != {"name", "value"}: die("mfa.json : paramètre supplémentaire invalide")
        text(e["name"], "nom de paramètre", 1, 40, FIELD); text(e["value"], "valeur de paramètre", 0, 200, EXTRA_VAL)
        if e["name"] in taken: die("mfa.json : paramètre en double ou réservé (%s)" % e["name"][:40])
        taken.add(e["name"])
    mfa_ca_ok = False
    if mfa_ca_txt is not None:
        CERT2 = re.compile(r"-----BEGIN CERTIFICATE-----\r?\n[A-Za-z0-9+/=\r\n]+?-----END CERTIFICATE-----\r?\n?")
        blocks2 = CERT2.findall(mfa_ca_txt)
        if not blocks2 or CERT2.sub("", mfa_ca_txt).strip() or len(blocks2) > 10: die("mfa-ca.pem : 1 à 10 certificats PEM attendus, rien d'autre")
        tmp2 = tempfile.mkdtemp(prefix="ddi-mfaca-"); atexit.register(shutil.rmtree, tmp2, True)
        for i, b in enumerate(blocks2):
            f = os.path.join(tmp2, "c%d.pem" % i); open(f, "w").write(b)
            if subprocess.run(["openssl", "x509", "-in", f, "-noout", "-subject"], capture_output=True, timeout=20).returncode != 0: die("mfa-ca.pem : certificat illisible (n° %d)" % (i + 1))
        mfa_ca_ok = True
    mfa = {"url": mu.group(0), "origin": "https://" + mu.group("host") + (":" + mu.group("port") if mu.group("port") else ""), "cid": cid, "csec": csec, "f_id": f_id, "f_pw": f_pw, "f_otp": f_otp,
           "ident": ident, "digits": digits, "timeout": mto, "verify": mfa_doc["tlsVerify"], "extra": extra_p, "ca": mfa_ca_ok}
elif mfa_ca_txt is not None: die("mfa-ca.pem sans mfa.json")

# ---- règles ----
if not isinstance(rules_doc, dict) or not isinstance(rules_doc.get("rules"), list): die("rules.json : liste « rules » attendue")
rules = rules_doc["rules"]
if not (1 <= len(rules) <= 200): die("1 à 200 règles attendues")
known = set()
try: txt = open(clients_file, encoding="utf-8").read()
except OSError: die("fichier de clients illisible")
for m in re.finditer(r'^client "([a-z][a-z0-9-]{0,40})" \{$', txt, re.M): known.add(m.group(1))
known.discard("ddi-selftest")
# 0.17.0 : clients dont les requêtes PAP passent par le serveur MFA (directive validée par validate_clients)
mfa_clients, cur_client = [], None
for ln in txt.split("\n"):
    ln = ln.strip()
    m = re.match(r'^client "([a-z][a-z0-9-]{0,40})" \{$', ln)
    if m: cur_client = m.group(1)
    elif ln == "virtual_server = ddibuntu-mfa" and cur_client: mfa_clients.append(cur_client)
if mfa_clients and mfa is None: die("des clients sont marqués MFA (%s) mais aucun fournisseur MFA n'est déposé" % mfa_clients[0][:41])
NAME = re.compile(r"[a-z][a-z0-9-]{0,40}")
GDN = re.compile(r"(?:[^\x00-\x1f\x7f\"$%{}`\\]|\\[,+<>;=# \\]){3,512}")
SSID = re.compile(r"[A-Za-z0-9 ._@#&+=,;:!()/-]{1,32}")
POOL = re.compile(r"[A-Za-z0-9._-]{1,63}")
FILT = re.compile(r"[A-Za-z0-9 ._:@=/,;()#*+-]{1,128}")
VENDOR = {"Aruba-User-Role": re.compile(r"[A-Za-z0-9 ._:@=/,;()#*+-]{1,128}"), "Fortinet-Group-Name": re.compile(r"[A-Za-z0-9 ._:@=/,;()#*+-]{1,128}"),
          "Reply-Message": re.compile(r"[A-Za-z0-9 ._:@=/,;()#*+!?-]{1,128}"), "Cisco-AVPair": re.compile(r"[A-Za-z0-9 ._:@=/,;()#*+-]{1,200}")}
uses_ssid = False
out = []
for n, r in enumerate(rules, 1):
    if not isinstance(r, dict): die("règle %d : objet attendu" % n)
    extra = set(r) - {"name", "action", "kind", "groups", "nas", "ssids", "reply"}
    if extra: die("règle %d : champ inattendu" % n)
    label = re.sub(r"[^A-Za-z0-9 ._-]", "?", str(r.get("name", ""))[:60])
    act = r.get("action")
    if act not in ("accept", "reject"): die("règle %d : action invalide" % n)
    kind = r.get("kind")
    if kind not in (None, "user", "computer"): die("règle %d : type d'identité invalide" % n)
    groups = r.get("groups", [])
    if not isinstance(groups, list) or len(groups) > 30: die("règle %d : 30 groupes au plus" % n)
    groups = [text(g, "règle %d : groupe" % n, 3, 512, GDN) for g in groups]
    for g in groups:
        if "=" not in g: die("règle %d : groupe invalide" % n)
    nas = r.get("nas")
    if nas is not None:
        if not isinstance(nas, list) or len(nas) > 2000: die("règle %d : liste de clients invalide" % n)
        for c in nas:
            text(c, "règle %d : client" % n, 1, 41, NAME)
            if c not in known: die("règle %d : client inconnu « %s » (absent du fichier de clients déposé)" % (n, c))
    ssids = r.get("ssids", [])
    if not isinstance(ssids, list) or len(ssids) > 20: die("règle %d : 20 SSID au plus" % n)
    ssids = [text(s, "règle %d : SSID" % n, 1, 32, SSID) for s in ssids]
    if ssids: uses_ssid = True
    reply = r.get("reply", {})
    if not isinstance(reply, dict) or set(reply) - {"vlan", "pool", "sessionTimeout", "filterId", "attrs"}: die("règle %d : réponse invalide" % n)
    if act == "reject" and reply: die("règle %d : un refus ne porte aucun attribut de réponse" % n)
    rl = []
    if "vlan" in reply:
        v = integer(reply["vlan"], "règle %d : VLAN" % n, 1, 4094)
        rl += ["&Tunnel-Type := VLAN", "&Tunnel-Medium-Type := IEEE-802", "&Tunnel-Private-Group-Id := '%d'" % v]
    if "pool" in reply: rl.append("&Framed-Pool := " + sq(text(reply["pool"], "règle %d : pool" % n, 1, 63, POOL)))
    if "sessionTimeout" in reply: rl.append("&Session-Timeout := %d" % integer(reply["sessionTimeout"], "règle %d : durée de session" % n, 60, 2592000))
    if "filterId" in reply: rl.append("&Filter-Id := " + sq(text(reply["filterId"], "règle %d : Filter-Id" % n, 1, 128, FILT)))
    attrs = reply.get("attrs", [])
    if not isinstance(attrs, list) or len(attrs) > 8: die("règle %d : 8 attributs au plus" % n)
    seen_attr = set()
    for a in attrs:
        if not isinstance(a, dict) or set(a) != {"name", "value"} or a["name"] not in VENDOR: die("règle %d : attribut non autorisé" % n)
        if a["name"] in seen_attr: die("règle %d : attribut en double (%s)" % (n, a["name"]))
        seen_attr.add(a["name"])
        rl.append("&%s := %s" % (a["name"], sq(text(a["value"], "règle %d : %s" % (n, a["name"]), 1, 200, VENDOR[a["name"]]))))
    out.append({"n": n, "label": label, "act": act, "kind": kind, "groups": groups, "nas": nas, "ssids": ssids, "reply": rl})

# ---- module LDAP (généré ici) ----
L = ["# Généré par ddibuntu-radius : lecture seule de l'annuaire (état du compte et groupes imbriqués). Ne pas modifier à la main.", "ldap {"]
for u in urls: L.append("\tserver = " + dq(u))
L += ["\tidentity = " + dq(bind_dn), "\tpassword = " + dq(bind_pw), "\tbase_dn = " + dq(base_dn),
      "\tupdate {", "\t\tcontrol:Tmp-String-3 := 'userAccountControl'", "\t\tcontrol:Tmp-String-4 := 'msDS-User-Account-Control-Computed'", "\t\tcontrol:Tmp-String-5 := 'accountExpires'", "\t\tcontrol:Tmp-String-9 := 'sAMAccountName'", "\t}",
      '\tuser_dn = "LDAP-UserDn"',
      "\tuser {", '\t\tbase_dn = "${..base_dn}"',
      '\t\tfilter = "(&(objectClass=user)(objectCategory=%{control:Tmp-String-7})(%{control:Tmp-String-6}=%{control:Tmp-String-1}))"', "\t\tscope = sub", "\t}",
      "\tgroup {", '\t\tbase_dn = "${..base_dn}"', "\t\tfilter = '(objectClass=group)'", "\t\tname_attribute = cn",
      '\t\tmembership_filter = "(&(objectClass=group)(member:1.2.840.113556.1.4.1941:=%{control:LDAP-UserDn}))"', "\t\tcacheable_name = no", "\t\tcacheable_dn = yes", "\t}",
      "\toptions {", "\t\tchase_referrals = no", "\t\trebind = no", "\t\tres_timeout = 10", "\t\tsrv_timelimit = 5", "\t\tnet_timeout = 3", "\t\tidle = 60", "\t\tprobes = 3", "\t\tinterval = 3", "\t}",
      "\ttls {", ("\t\tca_file = ${certdir}/ldap-ca.pem" if ca_ok else "\t\tca_file = '/etc/ssl/certs/ca-certificates.crt'"), "\t\trequire_cert = '%s'" % ("demand" if reject_unauth else "never"), "\t}",
      # connexions ouvertes à la demande : avec start = 1 (défaut), FreeRADIUS REFUSE de démarrer quand l'annuaire est injoignable.
      # max >= max_servers (radiusd.conf, 32 fils) : un fil n'attend jamais de connexion — à saturation FreeRADIUS ne met PAS en file, il
      # échoue aussitôt (« Cannot open new connection, already at max ») et la requête serait refusée à tort lors d'une pointe d'authentifications.
      "\tpool {", "\t\tstart = 0", "\t\tmin = 0", "\t\tmax = 32", "\t\tspare = 1", "\t\tuses = 0", "\t\tretry_delay = 5", "\t\tlifetime = 0", "\t\tidle_timeout = 60", "\t}", "}"]

# ---- serveur de décision (généré ici) ----
S = []
def block(lines, ind):
    S.extend("\t" * ind + l for l in lines)
def deny(msg, ind):
    block(["update config {", "\t&Auth-Type := Reject", "}", "update outer.request {", '\t&Module-Failure-Message := "ddibuntu : %s"' % msg, "}", "return"], ind)
S += ["# Généré par ddibuntu-radius : décision d'accès après la poignée de main EAP-TLS (chaîne, dates, usage et révocation déjà contrôlés).",
      "# Ordre : identité du certificat → compte dans l'annuaire → état du compte → règles dans l'ordre (première correspondance) → refus par défaut.",
      "# Seul Auth-Type décide dans ce serveur virtuel (un « reject » simple n'a aucun effet).", "server ddibuntu-check-eap-tls {", "\tauthorize {"]
block(["# 1. identité portée par le certificat : UPN (utilisateur), sinon nom DNS (machine)",
       "if (&TLS-Client-Cert-Subject-Alt-Name-Upn) {", "\tupdate control {", "\t\t&Tmp-String-0 := 'user'", "\t\t&Tmp-String-1 := &TLS-Client-Cert-Subject-Alt-Name-Upn[0]",
       "\t\t&Tmp-String-6 := 'userPrincipalName'", "\t\t&Tmp-String-7 := 'person'", "\t}", "}",
       "elsif (&TLS-Client-Cert-Subject-Alt-Name-Dns) {", "\tupdate control {", "\t\t&Tmp-String-0 := 'computer'", "\t\t&Tmp-String-1 := &TLS-Client-Cert-Subject-Alt-Name-Dns[0]",
       "\t\t&Tmp-String-6 := 'dNSHostName'", "\t\t&Tmp-String-7 := 'computer'", "\t}", "}", "else {"], 2)
deny("certificat sans identite (ni UPN ni nom DNS)", 3)
block(["}", "if (!&control:Tmp-String-1) {"], 2); deny("identite du certificat vide", 3)
block(["}", "# identité retenue, conservée pour le journal (session-state : survit jusqu'à la réponse finale, contrairement à la requête de ce tour)",
       "update outer.session-state {", "\t&Tmp-String-1 := \"%{control:Tmp-String-0}:%{control:Tmp-String-1}\"", "}",
       "# 2. compte dans l'annuaire (échec ou résultat ambigu = refus)", "ldap", "if (notfound) {"], 2); deny("compte introuvable dans l'annuaire", 3)
block(["}", "elsif (!(updated || ok)) {"], 2); deny("annuaire indisponible ou compte ambigu", 3)
block(["}", "# 3. état du compte : mêmes critères que la console (désactivé, verrouillé, expiré ; attributs illisibles = refus)",
       "if (!&control:Tmp-String-3 || &control:Tmp-String-3 !~ /^[0-9]{1,10}$/) {"], 2); deny("attributs du compte illisibles", 3)
block(["}", "if (\"%{expr:%{control:Tmp-String-3} & 2}\" != '0') {"], 2); deny("compte desactive", 3)
block(["}", "if (&control:Tmp-String-4 && &control:Tmp-String-4 =~ /^[0-9]{1,10}$/) {", "\tif (\"%{expr:%{control:Tmp-String-4} & 16}\" != '0') {"], 2); deny("compte verrouille", 4)
block(["\t}", "}", "elsif (\"%{expr:%{control:Tmp-String-3} & 16}\" != '0') {"], 2); deny("compte verrouille", 3)
block(["}", "if (&control:Tmp-String-5 && &control:Tmp-String-5 =~ /^[0-9]{1,18}$/ && &control:Tmp-String-5 != '0') {",
       "\tif (\"%{expr:%l - (%{control:Tmp-String-5} / 10000000 - 11644473600)}\" =~ /^[0-9]+$/) {"], 2); deny("compte expire", 4)
block(["\t}", "}"], 2)
if uses_ssid:
    block(["# SSID : suffixe de Called-Station-Id (« AA-BB-CC-DD-EE-FF:SSID »)",
           "if (\"%{outer.request:Called-Station-Id}\" =~ /^([0-9A-Fa-f]{2}[-:.]?){5}[0-9A-Fa-f]{2}:(.+)$/) {", "\tupdate control {", "\t\t&Tmp-String-2 := \"%{2}\"", "\t}", "}"], 2)
block(["# 4. règles d'accès, dans l'ordre : la première qui correspond décide"], 2)
for r in out:
    block(["", "# règle %d : %s (%s)" % (r["n"], r["label"], "accepter" if r["act"] == "accept" else "refuser")], 2)
    if r["nas"] is not None and len(r["nas"]) == 0:
        block(["# aucun client ne correspond : cette règle ne s'applique jamais"], 2); continue
    cond = []
    if r["kind"]: cond.append("&control:Tmp-String-0 == '%s'" % r["kind"])
    if r["groups"]: cond.append("(" + " || ".join("LDAP-Group == " + sq(g) for g in r["groups"]) + ")")
    if r["nas"]: cond.append("(" + " || ".join("\"%%{client:shortname}\" == '%s'" % c for c in r["nas"]) + ")")
    if r["ssids"]: cond.append("(" + " || ".join("&control:Tmp-String-2 == " + sq(s) for s in r["ssids"]) + ")")
    block(["if (%s) {" % (" && ".join(cond) if cond else "&control:Tmp-String-0")], 2)
    if r["act"] == "accept":
        if r["reply"]: block(["\tupdate outer.reply {"] + ["\t\t" + x for x in r["reply"]] + ["\t}"], 2)
        block(["\tupdate outer.session-state {", "\t\t&Tmp-String-0 := " + sq("regle %d : %s" % (r["n"], r["label"])), "\t}"], 2)
        block(["\tupdate config {", "\t\t&Auth-Type := Accept", "\t}", "\treturn"], 2)
    else:
        block(["\tupdate config {", "\t\t&Auth-Type := Reject", "\t}", "\tupdate outer.request {", "\t\t&Module-Failure-Message := \"ddibuntu : regle %d : refus\"" % r["n"], "\t}", "\treturn"], 2)
    block(["}"], 2)
block(["", "# 5. refus par défaut"], 2); deny("aucune regle ne correspond (refus par defaut)", 2)
S += ["\t}", "}"]

# ---- serveur « tunnel » PEAP / EAP-TTLS (0.16.0) ----
# Mêmes contrôles que la décision EAP-TLS (identité → compte → état du compte → règles dans l'ordre → refus par défaut), exécutés AVANT le mot de passe :
# un compte désactivé, verrouillé ou hors règles est refusé sans jamais tenter l'authentification. Ensuite seulement le mot de passe est vérifié
# (EAP-TTLS/PAP : liaison LDAPS de l'utilisateur ; PEAP-MSCHAPv2 : ntlm_auth, via winbind). Ici « reject » refuse vraiment (contrairement au serveur EAP-TLS).
I = []
def iemit(lines, ind): I.extend("\t" * ind + l for l in lines)
# PEAP / TTLS répondent au refus du tunnel par un tour de plus avant l'Access-Reject final (autre requête) : la raison est donc aussi gardée dans l'état de session
def ideny(msg, ind): iemit(["update outer.request {", '\t&Module-Failure-Message := "ddibuntu : %s"' % msg, "}", "update outer.session-state {", '\t&Module-Failure-Message := "ddibuntu : %s"' % msg, "}", "reject"], ind)
# 0.17.0 : contrôles communs au tunnel PEAP / TTLS et au serveur MFA (client dont la requête PAP est vérifiée par un fournisseur externe) : identité → annuaire → état du compte → règles dans l'ordre.
# Les émetteurs reçoivent les lignes de « tunnel » (listes « outer. ») : pour le serveur MFA, qui n'a pas de tunnel, le préfixe « outer. » est retiré à l'émission.
def user_checks(iemit, ideny, nbl):
    iemit(["# 1. identifiant présenté dans le tunnel : « DOMAINE\\compte », « compte@suffixe » ou « compte » (jeu de caractères restreint : l'identifiant sert d'argument à ntlm_auth)",
           "if (!&User-Name || &User-Name !~ /^[A-Za-z0-9._@+\\\\-]{1,128}$/) {"], 2)
    ideny("identifiant non pris en charge", 3)
    iemit(["}", "if (&User-Name =~ /^([^\\\\]+)\\\\(.+)$/) {"], 2)
    if nbl:
        iemit(["\tif (\"%{tolower:%{1}}\" != " + sq(nbl) + ") {"], 2)
        ideny("domaine inconnu", 4)
        iemit(["\t}"], 2)
    else:
        ideny("nom NetBIOS du domaine non configure", 3)
    iemit(["\tupdate control {", "\t\t&Tmp-String-0 := 'user'", "\t\t&Tmp-String-1 := \"%{2}\"", "\t\t&Tmp-String-6 := 'sAMAccountName'", "\t\t&Tmp-String-7 := 'person'", "\t}",
           "}", "elsif (&User-Name =~ /^([^@]+)@(.+)$/) {",
           "\tupdate control {", "\t\t&Tmp-String-0 := 'user'", "\t\t&Tmp-String-1 := &User-Name", "\t\t&Tmp-String-6 := 'userPrincipalName'", "\t\t&Tmp-String-7 := 'person'", "\t}",
           "}", "else {",
           "\tupdate control {", "\t\t&Tmp-String-0 := 'user'", "\t\t&Tmp-String-1 := &User-Name", "\t\t&Tmp-String-6 := 'sAMAccountName'", "\t\t&Tmp-String-7 := 'person'", "\t}",
           "}",
           "# identité retenue, conservée pour le journal",
           "update outer.session-state {", "\t&Tmp-String-1 := \"%{control:Tmp-String-0}:%{control:Tmp-String-1}\"", "}",
           "# 2. compte dans l'annuaire (échec ou résultat ambigu = refus)", "ldap", "if (notfound) {"], 2); ideny("compte introuvable dans l'annuaire", 3)
    iemit(["}", "elsif (!(updated || ok)) {"], 2); ideny("annuaire indisponible ou compte ambigu", 3)
    iemit(["}", "# 3. état du compte : mêmes critères que la console et que EAP-TLS",
           "if (!&control:Tmp-String-3 || &control:Tmp-String-3 !~ /^[0-9]{1,10}$/) {"], 2); ideny("attributs du compte illisibles", 3)
    iemit(["}", "if (\"%{expr:%{control:Tmp-String-3} & 2}\" != '0') {"], 2); ideny("compte desactive", 3)
    iemit(["}", "if (&control:Tmp-String-4 && &control:Tmp-String-4 =~ /^[0-9]{1,10}$/) {", "\tif (\"%{expr:%{control:Tmp-String-4} & 16}\" != '0') {"], 2); ideny("compte verrouille", 4)
    iemit(["\t}", "}", "elsif (\"%{expr:%{control:Tmp-String-3} & 16}\" != '0') {"], 2); ideny("compte verrouille", 3)
    iemit(["}", "if (&control:Tmp-String-5 && &control:Tmp-String-5 =~ /^[0-9]{1,18}$/ && &control:Tmp-String-5 != '0') {",
           "\tif (\"%{expr:%l - (%{control:Tmp-String-5} / 10000000 - 11644473600)}\" =~ /^[0-9]+$/) {"], 2); ideny("compte expire", 4)
    iemit(["\t}", "}"], 2)
    if uses_ssid:
        iemit(["# SSID : suffixe de Called-Station-Id (« AA-BB-CC-DD-EE-FF:SSID »)",
               "if (\"%{outer.request:Called-Station-Id}\" =~ /^([0-9A-Fa-f]{2}[-:.]?){5}[0-9A-Fa-f]{2}:(.+)$/) {", "\tupdate control {", "\t\t&Tmp-String-2 := \"%{2}\"", "\t}", "}"], 2)
    iemit(["# 4. règles d'accès, dans l'ordre : la première qui correspond décide (si / sinon si : aucune sortie anticipée, l'authentification suit)"], 2)
    first = True
    for r in out:
        if r["nas"] is not None and len(r["nas"]) == 0: continue
        if r["kind"] == "computer": continue      # un identifiant et un mot de passe désignent toujours un utilisateur, jamais une machine
        cond = ["&control:Tmp-String-0 == 'user'"]
        if r["groups"]: cond.append("(" + " || ".join("LDAP-Group == " + sq(g) for g in r["groups"]) + ")")
        if r["nas"]: cond.append("(" + " || ".join("\"%%{client:shortname}\" == '%s'" % c for c in r["nas"]) + ")")
        if r["ssids"]: cond.append("(" + " || ".join("&control:Tmp-String-2 == " + sq(x) for x in r["ssids"]) + ")")
        iemit(["", "# règle %d : %s (%s)" % (r["n"], r["label"], "accepter" if r["act"] == "accept" else "refuser")] + ([] if first else ["}"]) +
              [("if (%s) {" if first else "elsif (%s) {") % " && ".join(cond)], 2)
        first = False
        if r["act"] == "accept":
            iemit(["\tupdate control {", "\t\t&Tmp-String-8 := '%d'" % r["n"], "\t}",
                   "\tupdate outer.session-state {", "\t\t&Tmp-String-0 := " + sq("regle %d : %s" % (r["n"], r["label"])), "\t}"], 2)
        else:
            ideny("regle %d : refus" % r["n"], 3)
    iemit((["}", "else {"] if not first else ["if (1) {"]), 2)
    ideny("aucune regle ne correspond (refus par defaut)", 3)

if peap_on or ttls_on:
    nbl = netbios.lower()
    I += ["# Généré par ddibuntu-radius : tunnel PEAP / EAP-TTLS (identifiant et mot de passe). Contrôles d'accès AVANT la vérification du mot de passe.",
          "server ddibuntu-inner {", "\tauthorize {"]
    user_checks(iemit, ideny, nbl)
    iemit(["}", "", "# 5. mot de passe : EAP-TTLS/PAP = liaison LDAPS de l'utilisateur ; PEAP (et TTLS) EAP-MSCHAPv2 = module mschap (ntlm_auth) appelé par eap"], 2)
    if peap_on: iemit(["mschap"], 2)
    iemit(["if (&User-Password) {", "\tupdate control {", "\t\t&Auth-Type := LDAP", "\t}", "}", "else {", "\teap {", "\t\tok = return", "\t\tupdated = return", "\t}", "}"], 2)
    I += ["\t}", "\tauthenticate {", "\t\tAuth-Type LDAP {", "\t\t\tldap", "\t\t}", "\t\tAuth-Type eap {", "\t\t\teap", "\t\t}"]
    if peap_on: I += ["\t\tAuth-Type MS-CHAP {", "\t\t\tmschap", "\t\t}"]
    I += ["\t}", "\tpost-auth {"]
    for r in out:
        if r["act"] == "accept" and r["reply"] and not (r["nas"] is not None and len(r["nas"]) == 0):
            iemit(["if (&control:Tmp-String-8 == '%d') {" % r["n"], "\tupdate outer.reply {"] + ["\t\t" + x for x in r["reply"]] + ["\t}", "}"], 2)
    I += ["\t\tPost-Auth-Type REJECT {", "\t\t\tattr_filter.access_reject", "\t\t}", "\t}", "}"]
# ---- serveur « MFA » (0.17.0) ----
# Les clients marqués MFA (directive « virtual_server = ddibuntu-mfa » du fichier de clients) n'utilisent jamais EAP : mot de passe PAP, avec le code à usage unique collé à la fin.
# Mêmes contrôles que le tunnel (identité → annuaire → état du compte → règles) AVANT d'appeler le fournisseur : un compte désactivé, verrouillé ou hors règles n'atteint jamais
# le fournisseur. Ensuite le fournisseur reçoit « mot de passe » et « code » séparés, en HTTPS, et seule sa réponse de succès (2xx) accepte. Ni le mot de passe ni le code ne sont
# journalisés (journal des authentifications : nom présenté, identité, règle, raison).
X, MFAMOD = [], []
if mfa_clients:
    xemit = lambda lines, ind: X.extend("\t" * ind + l.replace("outer.", "") for l in lines)
    def xdeny(msg, ind): xemit(["update outer.request {", '\t&Module-Failure-Message := "ddibuntu : %s"' % msg, "}", "update outer.session-state {", '\t&Module-Failure-Message := "ddibuntu : %s"' % msg, "}", "reject"], ind)
    X += ["# Généré par ddibuntu-radius : clients protégés par un fournisseur MFA externe (PAP : mot de passe + code à usage unique). Ne pas modifier à la main.",
          "server ddibuntu-mfa {", "\tauthorize {"]
    xemit(["# 0. PAP seulement : ni EAP, ni CHAP, ni MS-CHAP (le fournisseur a besoin du mot de passe en clair)",
           "if (&EAP-Message) {"], 2); xdeny("EAP non pris en charge sur un client MFA (PAP seulement)", 3)
    xemit(["}", "if (!&User-Password) {"], 2); xdeny("mot de passe PAP attendu", 3)
    xemit(["}"], 2)
    user_checks(xemit, xdeny, netbios.lower())
    xemit(["}", "", "# 5. code à usage unique : les %d derniers caractères du mot de passe présenté (mot de passe + code, collés), chiffres seulement" % mfa["digits"],
           "if (&User-Password =~ /^(.+)([0-9]{%d})$/) {" % mfa["digits"], "\tupdate request {"] +
          (["\t\t&Tmp-String-0 := &User-Name"] if mfa["ident"] == "typed" else ["\t\t&Tmp-String-0 := &control:Tmp-String-9"]) +
          ["\t\t&Tmp-String-1 := \"%{1}\"", "\t\t&Tmp-String-2 := \"%{2}\"", "\t}", "\tupdate control {", "\t\t&Auth-Type := ddibuntu-mfa", "\t}", "}", "else {"], 2)
    xdeny("code a usage unique absent ou mal forme", 3)
    xemit(["}"] + ([] if mfa["ident"] == "typed" else ["if (!&request:Tmp-String-0) {"]), 2)
    if mfa["ident"] != "typed":
        xdeny("identifiant du compte illisible", 3); xemit(["}"], 2)
    X += ["\t}", "\tauthenticate {", "\t\tAuth-Type ddibuntu-mfa {"]
    # un refus du module ne doit pas interrompre la section : le motif est choisi ici (reject = 1, etc. : on continue avec ce code de retour)
    xemit(["ddibuntu_mfa {", "\tok = 1", "\tupdated = 1", "\treject = 1", "\tfail = 1", "\tinvalid = 1", "\tnotfound = 1", "\tuserlock = 1", "}",
           # « if (ok || updated) » lit le code de retour de l'instruction PRÉCÉDENTE : rien (pas même un « update ») ne doit s'intercaler entre le module et ce test
           "if (ok || updated) {",
           "\t# un 2xx ne suffit pas : une page ou un portail qui répond 200 n'est pas un jeton. Le corps doit porter un jeton d'accès (RFC 6749)",
           "\tif (&reply:REST-HTTP-Body =~ /access_token/) {",
           "\t\t# la réponse du fournisseur (jeton) ne sert à rien et ne doit jamais atteindre le client : retirée",
           "\t\tupdate reply {", "\t\t\t&REST-HTTP-Body !* ANY", "\t\t}", "\t\tok", "\t}", "\telse {"], 3)
    xdeny("fournisseur MFA : erreur, reponse sans jeton d acces", 5)
    xemit(["\t}", "}", "elsif (reject || userlock || notfound) {"], 3)
    xdeny("fournisseur MFA : mot de passe ou code refuse", 4)
    xemit(["}", "else {"], 3)
    xdeny("fournisseur MFA : erreur, injoignable ou refus (HTTP 4xx autre que 401, 5xx, delai)", 4)
    xemit(["}"], 3)
    X += ["\t\t}", "\t}", "\tpreacct {", "\t\tpreprocess", "\t}", "\taccounting {", "\t\tok", "\t}", "\tsession {", "\t}", "\tpost-auth {", "\t\tddibuntu_authlog_ok"]
    for r in out:
        if r["act"] == "accept" and r["reply"] and not (r["nas"] is not None and len(r["nas"]) == 0) and r["kind"] != "computer":
            xemit(["if (&control:Tmp-String-8 == '%d') {" % r["n"], "\tupdate reply {"] + ["\t\t" + x for x in r["reply"]] + ["\t}", "}"], 2)
    X += ["\t\tPost-Auth-Type REJECT {", "\t\t\tddibuntu_authlog_ko", "\t\t\tattr_filter.access_reject", "\t\t}", "\t}", "}"]
    # module REST : requête POST « formulaire » vers le point de jeton du fournisseur (flux OAuth2 « mot de passe » : grant_type=password)
    q = lambda v: v.replace(" ", "+")
    data = "grant_type=password&client_id=%s" % mfa["cid"] + ("&client_secret=%s" % mfa["csec"] if mfa["csec"] else "") + \
           "&%s=%%{urlquote:%%{request:Tmp-String-0}}&%s=%%{urlquote:%%{request:Tmp-String-1}}&%s=%%{urlquote:%%{request:Tmp-String-2}}" % (mfa["f_id"], mfa["f_pw"], mfa["f_otp"]) + \
           "".join("&%s=%s" % (e["name"], q(e["value"])) for e in mfa["extra"])
    MFAMOD = ["# Généré par ddibuntu-radius : fournisseur MFA (OAuth2, flux « mot de passe » + code à usage unique). Contient le secret client : ne pas copier. Ne pas modifier à la main.", "rest ddibuntu_mfa {",
              "\ttls {"] + (["\t\tca_path = ${certdir}/mfa-ca"] if mfa["ca"] else []) + ["\t\tcheck_cert = %s" % ("yes" if mfa["verify"] else "no"), "\t\tcheck_cert_cn = %s" % ("yes" if mfa["verify"] else "no"), "\t}",
              "\tconnect_uri = " + dq(mfa["origin"]), "\tconnect_timeout = 3.0",
              "\tauthenticate {", "\t\turi = " + dq(mfa["url"]), "\t\tmethod = 'post'", "\t\tbody = 'post'", "\t\tforce_to = 'plain'",   # force_to : la réponse n'est jamais interprétée comme des attributs
              "\t\tdata = " + dq(data), "\t\ttimeout = %d.0" % mfa["timeout"], "\t\ttls = ${..tls}", "\t}",
              "\tpool {", "\t\tstart = 0", "\t\tmin = 0", "\t\tmax = 32", "\t\tspare = 1", "\t\tuses = 0", "\t\tretry_delay = 5", "\t\tlifetime = 0", "\t\tidle_timeout = 60", "\t}", "}"]
M = []
if peap_on:
    M = ["# Généré par ddibuntu-radius : vérification MSCHAPv2 par ntlm_auth (winbind, jonction au domaine). Ne pas modifier à la main.", "mschap {",
         "\tuse_mppe = yes", "\trequire_encryption = yes", "\trequire_strong = yes", "\twith_ntdomain_hack = yes",
         "\tntlm_auth = \"%s --configfile=%s --allow-mschapv2 --request-nt-key --username=%%{control:Tmp-String-9} --domain=%s --challenge=%%{%%{mschap:Challenge}:-00} --nt-response=%%{%%{mschap:NT-Response}:-00}\"" % (NTLM_AUTH, os.path.join(WBSTATE, "smb.conf"), netbios),
         "\tntlm_auth_timeout = 10", "}"]
for g in ["ldap.mod", "site.conf", "ldap-ca.pem", "inner.conf", "mschap.mod", "methods", "mfa.conf", "mfa.mod", "mfa-ca.pem"]:
    p = os.path.join(snap, g)
    if os.path.lexists(p): os.unlink(p)
import shutil
shutil.rmtree(os.path.join(snap, "mfa-ca"), ignore_errors=True)
def put(name, txt):
    fd = os.open(os.path.join(snap, name), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as h: h.write(txt)
os.makedirs(snap, exist_ok=True)
put("ldap.mod", "\n".join(L) + "\n"); put("site.conf", "\n".join(S) + "\n")
if I: put("inner.conf", "\n".join(I) + "\n")
if M: put("mschap.mod", "\n".join(M) + "\n")
if X: put("mfa.conf", "\n".join(X) + "\n"); put("mfa.mod", "\n".join(MFAMOD) + "\n")
if X and mfa["ca"]:   # un certificat par fichier : « openssl rehash » (installation) l'exige, et c'est ca_path (pas ca_file) que rlm_rest applique
    os.makedirs(os.path.join(snap, "mfa-ca"), mode=0o700, exist_ok=True)
    for i, blk in enumerate(CERT2.findall(mfa_ca_txt)): put(os.path.join("mfa-ca", "%02d.pem" % (i + 1)), blk if blk.endswith("\n") else blk + "\n")
if I: put("methods", " ".join([m for m, on in (("peap", peap_on), ("ttls", ttls_on)) if on]) + "\n")
if ca_ok: put("ldap-ca.pem", "".join(CERT.findall(ca_txt)))
print("rules=%d servers=%s" % (len(out), ",".join(urls)))
print("methods=%s" % ",".join([m for m, on in (("peap", peap_on), ("ttls", ttls_on)) if on]))
print("peap=%d ttls=%d" % (peap_on, ttls_on))
if X: print("mfa=%s" % ",".join(mfa_clients))
for n in notes: print(n)
PY
}

# ---- Journal des authentifications ----
# Une ligne par décision (Access-Accept ou Access-Reject), champs séparés par « | », valeurs passées par %{escape:} : tout caractère hors liste
# sûre (dont « | », guillemets, retours à la ligne) devient « =XX » (hexadécimal, octet par octet), la console le décode. Format versionné (« v1 »).
# Colonnes : v1|heure(epoch)|résultat|nom présenté|équipement (client)|adresse de l'équipement|MAC du poste|station appelée (borne:SSID)|NAS-Identifier|
#            sujet|émetteur|série|fin de validité (certificat)|UPN|nom DNS|identité retenue|décision (règle)|raison
authlog_format() {
  local f="v1|%l|$1" x why=''
  [[ "$1" = reject ]] && why='%{%{session-state:Module-Failure-Message}:-%{Module-Failure-Message}}'   # la raison n'a de sens que pour un refus (le message d'un tour précédent ne doit pas coller à une acceptation)
  for x in '%{User-Name}' '%{client:shortname}' '%{%{Packet-Src-IP-Address}:-%{Packet-Src-IPv6-Address}}' '%{Calling-Station-Id}' '%{Called-Station-Id}' '%{NAS-Identifier}' \
           '%{%{session-state:TLS-Client-Cert-Subject}:-%{TLS-Client-Cert-Subject}}' '%{%{session-state:TLS-Client-Cert-Issuer}:-%{TLS-Client-Cert-Issuer}}' \
           '%{%{session-state:TLS-Client-Cert-Serial}:-%{TLS-Client-Cert-Serial}}' '%{%{session-state:TLS-Client-Cert-Expiration}:-%{TLS-Client-Cert-Expiration}}' \
           '%{%{session-state:TLS-Client-Cert-Subject-Alt-Name-Upn}:-%{TLS-Client-Cert-Subject-Alt-Name-Upn}}' '%{%{session-state:TLS-Client-Cert-Subject-Alt-Name-Dns}:-%{TLS-Client-Cert-Subject-Alt-Name-Dns}}' \
           '%{session-state:Tmp-String-1}' '%{session-state:Tmp-String-0}' "$why"; do
    if [[ -n "$x" ]]; then f+="|%{escape:$x}"; else f+="|"; fi
  done
  printf '%s' "$f"
}
write_authlog_module() {
  local f="$RDIR/mods-enabled/ddibuntu_authlog"
  cat > "$f" <<EOF
# Généré par ddibuntu-radius : journal des authentifications (lu par la console). Ne pas modifier à la main.
linelog ddibuntu_authlog_ok {
	filename = $AUTHLOG_DIR/radius-auth.log
	permissions = 0640
	escape_filenames = no
	format = "$(authlog_format accept)"
}
linelog ddibuntu_authlog_ko {
	filename = $AUTHLOG_DIR/radius-auth.log
	permissions = 0640
	escape_filenames = no
	format = "$(authlog_format reject)"
}
EOF
  chown root:"$GROUP" "$f" && chmod 0640 "$f"
}
# dossier du journal : propriétaire = le compte du démon (il y crée le fichier), groupe = la console (lecture seule), setgid pour que le fichier garde ce groupe
ensure_authlog_dir() {
  local g="$CONSOLE_GROUP"
  getent group "$g" >/dev/null || g="$GROUP"
  install -d -m 2750 -o "${DDI_RADIUS_USER:-freerad}" -g "$g" "$AUTHLOG_DIR" || return 1
  chown "${DDI_RADIUS_USER:-freerad}:$g" "$AUTHLOG_DIR" 2>/dev/null; chmod 2750 "$AUTHLOG_DIR" 2>/dev/null; return 0
}


# ---- Jonction au domaine (0.16.0) : PEAP-MSCHAPv2 ----
# MSCHAPv2 ne se vérifie pas par LDAP : seul un contrôleur de domaine (canal sécurisé NETLOGON) connaît le hachage du mot de passe. L'appliance est donc jointe au
# domaine avec un compte machine PROPRE À CE NŒUD (le mot de passe de ce compte tourne tout seul : on ne copie jamais son état d'un nœud à l'autre), puis winbindd
# répond à ntlm_auth, appelé par FreeRADIUS. Le compte qui sert à joindre n'est utilisé qu'une fois : écrit dans un fichier root 0600, écrasé aussitôt après.
winbind_joined() { [[ -f "$WBSTATE/joined.json" && ! -L "$WBSTATE/joined.json" ]]; }
write_wb_conf() {   # $1 = royaume DNS ; $2 = nom NetBIOS du domaine ; $3 = nom NetBIOS de cette machine ; $4… = contrôleurs de domaine
  local realm="$1" nb="$2" host="$3" W="$WBSTATE" up srv kdcs="" pws=""; shift 3
  up="$(printf '%s' "$realm" | tr '[:lower:]' '[:upper:]')"
  install -d -m 0755 "$W" "$W/run"
  install -d -m 0750 -o root -g "$GROUP" "$W/state" "$W/cache" "$W/lock"
  install -d -m 0700 "$W/private"
  for srv in "$@"; do kdcs+=$'\t\tkdc = '"$srv"$'\n'; pws+="$srv "; done
  cat > "$W/smb.conf" <<EOF
# Généré par ddibuntu-radius $(ddi_version) : winbind réservé au service RADIUS (PEAP-MSCHAPv2). Indépendant de /etc/samba. Ne pas modifier à la main.
[global]
	workgroup = $nb
	realm = $up
	security = ADS
	server role = member server
	netbios name = $host
	password server = ${pws% }
	kerberos method = secrets only
	client use spnego principal = no
	disable netbios = yes
	smb ports = 445
	name resolve order = host
	state directory = $W/state
	cache directory = $W/cache
	lock directory = $W/lock
	private dir = $W/private
	pid directory = $W/run
	ncalrpc dir = $W/run/ncalrpc
	log file = $W/state/log.%m
	log level = 1
	max log size = 2000
	idmap config * : backend = tdb
	idmap config * : range = 100000-199999
	winbind use default domain = no
	winbind enum users = no
	winbind enum groups = no
	winbind scan trusted domains = no
	winbind refresh tickets = no
	winbind offline logon = no
	load printers = no
	printcap name = /dev/null
	disable spoolss = yes
	dns proxy = no
EOF
  cat > "$W/krb5.conf" <<EOF
# Généré par ddibuntu-radius : Kerberos pour la jonction au domaine uniquement.
[libdefaults]
	default_realm = $up
	dns_lookup_realm = false
	dns_lookup_kdc = true
	rdns = false
[realms]
	$up = {
$kdcs	}
EOF
  chmod 0644 "$W/smb.conf" "$W/krb5.conf"
}
winbind_stop() {   # rien à arrêter tant que ce nœud n'a jamais été joint (le répertoire n'existe pas) : aucun appel à systemctl sur un nœud qui n'utilise pas PEAP
  [[ -d "$WBSTATE" ]] || return 0
  "$SYSCTL" disable --now "$WBSERVICE" >/dev/null 2>&1 || true
}
winbind_start() {   # démarre (ou redémarre) winbindd, puis ouvre son canal privilégié à FreeRADIUS (utilisateur freerad) : retour 1 si winbindd ne tient pas
  winbind_joined || return 1
  "$SYSCTL" daemon-reload >/dev/null 2>&1 || true
  { "$SYSCTL" enable "$WBSERVICE" >/dev/null 2>&1 && "$SYSCTL" restart "$WBSERVICE" >/dev/null 2>&1; } || return 1
  # Samba range le canal privilégié sous « state directory » (le paramètre « winbindd privileged socket directory » n'existe pas dans Samba 4.19)
  local _ priv="$WBSTATE/state/winbindd_privileged"; for _ in $(seq 1 20); do [[ -S "$priv/pipe" ]] && break; sleep 0.5; done
  [[ -S "$priv/pipe" ]] || return 1
  chgrp "$GROUP" "$priv" 2>/dev/null || true; chmod 0750 "$priv" 2>/dev/null || true
  "$SYSCTL" is-active --quiet "$WBSERVICE" >/dev/null 2>&1
}
# Vérifie le dépôt de la console (radius-join/join.json) ; écrit le fichier d'identification de « net » dans $2 (root, 0600). Sortie : realm=…, netbios=…, servers=…
validate_join() {   # $1 = dossier déposé ; $2 = fichier d'identification à écrire ; $3 = « join » (tous les champs) | « leave » (compte facultatif)
  python3 - "$@" <<'PY'
import json, os, re, sys
src, authf, mode = sys.argv[1], sys.argv[2], sys.argv[3]
def die(m): sys.stderr.write("jonction refusée : %s\n" % m); sys.exit(1)
if os.path.islink(src) or not os.path.isdir(src): die("dépôt absent")
if sorted(os.listdir(src)) != ["join.json"]: die("fichier inattendu dans le dépôt")
p = os.path.join(src, "join.json")
if os.path.islink(p) or not os.path.isfile(p) or os.path.getsize(p) > 8192: die("join.json absent ou trop volumineux")
try: d = json.loads(open(p, encoding="utf-8").read())
except (ValueError, UnicodeDecodeError): die("join.json illisible")
if not isinstance(d, dict) or set(d) - {"realm", "netbios", "servers", "user", "password"}: die("champ inconnu")
CTRL = re.compile(r"[\x00-\x1f\x7f]")
def text(k, lo, hi, rx=None):
    v = d.get(k)
    if not isinstance(v, str) or not (lo <= len(v) <= hi) or CTRL.search(v): die("%s : valeur invalide" % k)
    if rx is not None and not rx.fullmatch(v): die("%s : caractères refusés" % k)
    return v
realm = text("realm", 3, 253, re.compile(r"[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?"))
if "." not in realm: die("realm : nom DNS du domaine attendu (exemple : exemple.local)")
nb = text("netbios", 1, 15, re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,14}"))
servers = d.get("servers")
if not isinstance(servers, list) or not (1 <= len(servers) <= 5): die("servers : 1 à 5 contrôleurs de domaine attendus")
H = re.compile(r"[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?")
for h in servers:
    if not isinstance(h, str) or not H.fullmatch(h): die("servers : nom de serveur invalide")
if len(set(servers)) != len(servers): die("servers : doublon")
user = d.get("user"); pw = d.get("password")
if mode == "join" or user is not None or pw is not None:
    user = text("user", 1, 256); pw = text("password", 1, 256)
    if "%" in user: die("user : caractère refusé")
    fd = os.open(authf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as h: h.write("username = %s\npassword = %s\n" % (user, pw))
print("realm=" + realm); print("netbios=" + nb); print("servers=" + " ".join(servers))
PY
}
wb_field() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n1; }
cmd_join() {   # $1 = dossier radius-join déposé
  local src="${1:-}" t out realm nb servers host rc=0 hn
  [[ -x "$NET_BIN" ]] || { log "jonction : « net » (paquet samba-common-bin) n'est pas installé"; return 1; }
  [[ -x "$NTLM_AUTH" ]] || { log "jonction : ntlm_auth (paquet winbind) n'est pas installé"; return 1; }
  t="$(mktemp -d "${TMPDIR:-/tmp}/ddi-radius-join.XXXXXX")"; chmod 0700 "$t"
  # shellcheck disable=SC2064
  trap "find '$t' -type f -exec shred -u {} + 2>/dev/null; rm -rf '$t'" EXIT
  out="$(validate_join "$src" "$t/auth" join)" || return 1
  realm="$(wb_field "$out" realm)"; nb="$(wb_field "$out" netbios)"; servers="$(wb_field "$out" servers)"
  hn="$(hostname -s 2>/dev/null | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9\n-' '-' | sed 's/^-*//')"
  host="${DDI_RADIUS_COMPUTER:-RAD-${hn: -11}}"   # un compte machine distinct par nœud (15 caractères au plus), sans jamais reprendre le nom d'un autre compte
  host="${host:0:15}"; host="${host%-}"
  winbind_stop
  # shellcheck disable=SC2086
  write_wb_conf "$realm" "$nb" "$host" $servers
  KRB5CCNAME="FILE:$t/krb5cc" KRB5_CONFIG="$WBSTATE/krb5.conf" timeout 120 "$NET_BIN" ads join -s "$WBSTATE/smb.conf" -S "${servers%% *}" -A "$t/auth" >"$t/join.out" 2>&1 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    local why; why="$(grep -iE 'NT_STATUS|failed|cannot|unable|denied|logon|insufficient|timed? ?out|unreachable' "$t/join.out" | grep -v 'DNS update' | tail -n 2 | tr '\n' ' ' | tr -d '\000-\037' | cut -c1-240)"
    log "jonction refusée${why:+ : $why}"
    winbind_joined || rm -f "$WBSTATE/smb.conf" "$WBSTATE/krb5.conf"
    return 1
  fi
  python3 - "$WBSTATE/joined.json" "$realm" "$nb" "$host" "$servers" <<'PY'
import json, os, sys, time
p, realm, nb, host, servers = sys.argv[1:6]
t = p + ".new"
with open(t, "w") as h: json.dump({"realm": realm, "netbios": nb, "computer": host, "servers": servers.split(), "at": int(time.time())}, h)
os.chmod(t, 0o644); os.replace(t, p)
PY
  printf "Appliance jointe au domaine %s (compte machine %s). Redéployez le service pour activer PEAP-MSCHAPv2." "$realm" "$host"
}
cmd_leave() {   # $1 = dossier radius-join déposé (facultatif : avec un compte, le compte machine est aussi supprimé de l'annuaire)
  local src="${1:-}" t out="" servers="" rc=0 note=""
  t="$(mktemp -d "${TMPDIR:-/tmp}/ddi-radius-join.XXXXXX")"; chmod 0700 "$t"
  # shellcheck disable=SC2064
  trap "find '$t' -type f -exec shred -u {} + 2>/dev/null; rm -rf '$t'" EXIT
  if winbind_joined && [[ -n "$src" && -d "$src" && -x "$NET_BIN" ]]; then
    out="$(validate_join "$src" "$t/auth" leave)" || return 1   # dépôt invalide : rien n'est arrêté, la jonction reste en l'état
  fi
  winbind_stop
  if [[ -n "$out" ]]; then
    if [[ -f "$t/auth" ]]; then
      servers="$(wb_field "$out" servers)"
      KRB5CCNAME="FILE:$t/krb5cc" KRB5_CONFIG="$WBSTATE/krb5.conf" timeout 90 "$NET_BIN" ads leave -s "$WBSTATE/smb.conf" -S "${servers%% *}" -A "$t/auth" >/dev/null 2>&1 || rc=$?
      if [[ "$rc" -eq 0 ]]; then note=" Compte machine supprimé de l'annuaire."; else note=" AVERTISSEMENT : le compte machine n'a pas pu être supprimé de l'annuaire (à supprimer à la main)."; fi
    fi
  fi
  if [[ -d "$WBSTATE" ]]; then
    find "$WBSTATE/private" -type f -exec shred -u {} + 2>/dev/null || true
    rm -rf "$WBSTATE/private" "$WBSTATE/state" "$WBSTATE/cache" "$WBSTATE/lock" "$WBSTATE/run" "$WBSTATE/joined.json" "$WBSTATE/smb.conf" "$WBSTATE/krb5.conf"
  fi
  [[ -n "$note" ]] || note=" Le compte machine reste dans l'annuaire (à supprimer à la main)."
  printf "Jonction retirée de ce nœud : PEAP-MSCHAPv2 ne fonctionne plus ici.%s" "$note"
}
joinactive() { "$SYSCTL" is-active --quiet "$WBSERVICE" >/dev/null 2>&1 && echo true || echo false; }
jointrust() {   # le compte machine est-il toujours accepté par le domaine ? (unknown : non mesuré)
  winbind_joined && [[ "$(joinactive)" = true && -x "$NET_BIN" ]] || { echo unknown; return 0; }
  if KRB5_CONFIG="$WBSTATE/krb5.conf" timeout 8 "$NET_BIN" ads testjoin -s "$WBSTATE/smb.conf" >/dev/null 2>&1; then echo true; else echo false; fi
}
winbind_info() {   # état de la jonction (sans secret) publié pour la console
  W="$WBSTATE" A="$(joinactive)" T="$(jointrust)" python3 - <<'PY' 2>/dev/null || echo '{"joined": false}'
import json, os
try: d = json.load(open(os.path.join(os.environ["W"], "joined.json")))
except (OSError, ValueError): print(json.dumps({"joined": False})); raise SystemExit(0)
t = os.environ["T"]
print(json.dumps({"joined": True, "realm": str(d.get("realm", ""))[:253], "netbios": str(d.get("netbios", ""))[:15], "computer": str(d.get("computer", ""))[:15],
                  "at": d.get("at"), "active": os.environ["A"] == "true", "trust": None if t == "unknown" else t == "true"}))
PY
}

# ---- Arborescence FreeRADIUS gérée par DDI-Buntu ----
write_radiusd_conf() {
  cat > "$RDIR/radiusd.conf" <<EOF
# Généré par ddibuntu-radius $(ddi_version). Ne pas modifier à la main : réécrit à chaque déploiement.
prefix = /usr
exec_prefix = /usr
sysconfdir = /etc
localstatedir = /var
sbindir = \${exec_prefix}/sbin
logdir = /var/log/freeradius
raddbdir = $RDIR
radacctdir = \${logdir}/radacct
name = freeradius
confdir = \${raddbdir}
modconfdir = \${confdir}/mods-config
certdir = \${confdir}/certs
cadir = \${confdir}/certs
run_dir = \${localstatedir}/run/\${name}
db_dir = \${raddbdir}
libdir = /usr/lib/freeradius
pidfile = \${run_dir}/\${name}.pid
max_request_time = 30
cleanup_delay = 5
max_requests = 16384
hostname_lookups = no
log {
	destination = files
	colourise = no
	file = $AUTHLOG_DIR/radius.log
	syslog_facility = daemon
	stripped_names = no
	auth = yes
	auth_badpass = no
	auth_goodpass = no
}
checkrad = \${sbindir}/checkrad
security {
	user = freerad
	group = freerad
	allow_core_dumps = no
	max_attributes = 200
	reject_delay = 1
	status_server = no
	require_message_authenticator = yes
	limit_proxy_state = yes
}
proxy_requests = no
\$INCLUDE clients.conf
thread pool {
	start_servers = 5
	max_servers = 32
	min_spare_servers = 3
	max_spare_servers = 10
	max_requests_per_server = 0
	auto_limit_acct = no
}
modules {
	\$INCLUDE mods-enabled/
}
instantiate {
}
\$INCLUDE sites-enabled/
EOF
}
write_site() {   # $4 = serveur MFA (0.17.0, optionnel) ; $1 = eap (« eap » : EAP-TLS actif) ; sans argument : tout accès refusé (itérations 1 et 2) ; $2 = serveur de décision généré (règles d'accès) ; $3 = serveur « tunnel » PEAP / TTLS (optionnel)
  local v6="" eap="${1:-}" decision="${2:-}" inner="${3:-}" mfasrv="${4:-}"
  # écoute IPv6 seulement si la pile IPv6 existe (sinon freeradius refuse de démarrer)
  if [[ -r /proc/net/if_inet6 ]]; then
    v6=$'\tlisten {\n\t\ttype = auth\n\t\tipv6addr = ::\n\t\tport = 1812\n\t}\n\tlisten {\n\t\ttype = acct\n\t\tipv6addr = ::\n\t\tport = 1813\n\t}\n'
  fi
  { cat <<'EOF'
# Site RADIUS de DDI-Buntu. Refus par défaut : aucune règle d'accès n'existe encore (itération 4), donc aucun accès n'est jamais accordé.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
		limit {
			max_connections = 16
			lifetime = 0
			idle_timeout = 30
		}
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}
EOF
  printf '%s' "$v6"
  if [[ "$eap" = eap ]]; then
    cat <<'EOF'
	authorize {
		eap {
			ok = return
			updated = return
		}
		reject
	}
	authenticate {
		Auth-Type eap {
			eap
		}
	}
EOF
  else
    cat <<'EOF'
	authorize {
		reject
	}
	authenticate {
	}
EOF
  fi
  cat <<'EOF'
	preacct {
		preprocess
	}
	accounting {
		ok
	}
	session {
	}
	post-auth {
		ddibuntu_authlog_ok
		Post-Auth-Type REJECT {
			ddibuntu_authlog_ko
			attr_filter.access_reject
EOF
  [[ "$eap" = eap ]] && printf '\t\t\teap\n'
  cat <<'EOF'
		}
	}
}
EOF
  if [[ "$eap" = eap && -n "$decision" ]]; then
    cat "$decision"
    [[ -n "$inner" && -f "$inner" ]] && { printf '\n'; cat "$inner"; }
    [[ -n "$mfasrv" && -f "$mfasrv" ]] && { printf '\n'; cat "$mfasrv"; }
  elif [[ "$eap" = eap ]]; then
    cat <<'EOF'
# Appelé par EAP-TLS une fois la poignée de main réussie : la chaîne de confiance, les dates, l'usage et la révocation du certificat client
# ont déjà été contrôlés. Aucune règle d'accès n'est déployée : refus par défaut. ATTENTION : un simple « reject » ne suffit
# pas dans ce serveur virtuel, seul Auth-Type décide (Accept ou Reject) ; sans lui le certificat serait accepté. Le message distingue ce
# refus d'un échec TLS dans le journal.
server ddibuntu-check-eap-tls {
	authorize {
		update config {
			&Auth-Type := Reject
		}
		update outer.request {
			&Module-Failure-Message := "ddibuntu : certificat valide, aucune regle d'acces (refus par defaut)"
		}
	}
}
EOF
  fi
  } > "$RDIR/sites-available/ddibuntu"
}
write_eap_module() {   # $1 = true|false : vérification des révocations (CRL) ; $2 = méthodes par mot de passe actives (« peap », « ttls », séparées par un espace ; vide = EAP-TLS seulement)
  local crl=no pw="" meth=" ${2:-} "; [[ "$1" = true ]] && crl=yes
  if [[ "$meth" = *" peap "* || "$meth" = *" ttls "* ]]; then
    # le tunnel (PEAP / TTLS) est traité par le serveur virtuel « ddibuntu-inner » (voir le site) : mêmes règles d'accès, puis vérification du mot de passe
    # EAP-MSCHAPv2 (sous-module) exige la section « Auth-Type MS-CHAP » du serveur tunnel, qui n'existe que si PEAP est actif (appliance jointe) : sinon TTLS = PAP seulement
    local inner_eap=""
    if [[ "$meth" = *" peap "* ]]; then
      inner_eap=$'\t\tdefault_eap_type = mschapv2\n'
      pw=$'\tmschapv2 {\n\t\tsend_error = yes\n\t}\n'
      pw+=$'\tpeap {\n\t\ttls = tls-common\n\t\tdefault_eap_type = mschapv2\n\t\tcopy_request_to_tunnel = no\n\t\tuse_tunneled_reply = no\n\t\tvirtual_server = "ddibuntu-inner"\n\t}\n'
    fi
    [[ "$meth" = *" ttls "* ]] && pw+=$'\tttls {\n\t\ttls = tls-common\n'"$inner_eap"$'\t\tcopy_request_to_tunnel = no\n\t\tuse_tunneled_reply = no\n\t\tvirtual_server = "ddibuntu-inner"\n\t\tinclude_length = yes\n\t}\n'
  fi
  cat > "$RDIR/mods-enabled/eap" <<EOF
# Généré par ddibuntu-radius $(ddi_version). EAP-TLS${2:+ + méthodes par mot de passe ($2)} ; ne pas modifier à la main.
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = \${max_requests}
	tls-config tls-common {
		private_key_file = \${certdir}/server.key
		certificate_file = \${certdir}/server.pem
		ca_file = \${certdir}/ca.pem
		ca_path = \${certdir}/crl
		ca_path_reload_interval = 600
		auto_chain = no
		check_crl = $crl
		check_all_crl = no
		allow_expired_crl = no
		cipher_server_preference = no
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		ecdh_curve = ""
		cache {
			enable = no
		}
		verify {
		}
		ocsp {
			enable = no
		}
	}
	tls {
		tls = tls-common
		# décision d'accès une fois la poignée de main réussie (voir le site) : DOIT être ici, pas dans tls-config
		virtual_server = "ddibuntu-check-eap-tls"
	}
${pw}}
EOF
  # 0.14.16 : sous systemd le démon et son contrôle de démarrage tournent en freerad : sans le groupe (umask 027 : root:root 0640), « Permission denied » et le service ne démarre pas
  chown root:"$GROUP" "$RDIR/mods-enabled/eap" && chmod 0640 "$RDIR/mods-enabled/eap"
}
install_pki() {   # $1 = instantané validé (validate_pki) ; $2 = true|false (vérification des CRL) ; $3 = méthodes par mot de passe (voir write_eap_module)
  local c="$RDIR/certs" f
  install -d -m 0750 -o root -g "$GROUP" "$c" "$c/crl"
  install -m 0640 -o root -g "$GROUP" "$1/ca.pem" "$c/ca.pem"
  install -m 0640 -o root -g "$GROUP" "$1/server.pem" "$c/server.pem"
  install -m 0640 -o root -g "$GROUP" "$1/server.key" "$c/server.key"
  for f in "$1"/crl/*.pem; do [[ -e "$f" ]] && install -m 0640 -o root -g "$GROUP" "$f" "$c/crl/$(basename "$f")"; done
  # FreeRADIUS cherche les CRL par nom de hachage (<hash>.r0) dans ca_path
  compgen -G "$c/crl/*.pem" >/dev/null && openssl rehash "$c/crl" >/dev/null 2>&1
  write_eap_module "$2" "${3:-}"
}
build_tree() {   # $1 = clients.conf validé ; $2 = instantané PKI validé (optionnel) ; $3 = vérification des CRL (true|false) ; $4 = instantané des règles d'accès validé (optionnel, exige $2)
  [[ -d "$STOCK/mods-available" ]] || { log "modules du paquet freeradius introuvables ($STOCK)"; return 1; }
  getent group "$GROUP" >/dev/null || { log "groupe $GROUP absent (paquet freeradius non installé ?)"; return 1; }
  # le démon abandonne ses privilèges (utilisateur freerad) : le dossier parent doit rester traversable (umask 027 de ce script)
  [[ -d "$(dirname "$RDIR")" ]] || install -d -m 0755 "$(dirname "$RDIR")"
  install -d -m 0750 -o root -g "$GROUP" "$RDIR" "$RDIR/sites-available" "$RDIR/sites-enabled" "$RDIR/mods-enabled"
  local m mods="$MODULES"
  wipe_ldap "$RDIR"    # le module LDAP porte le mot de passe de liaison : écrasé avant suppression
  find "$RDIR/mods-enabled" "$RDIR/sites-enabled" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  wipe_certs "$RDIR"   # jamais de clé ni de certificat d'un déploiement précédent : réinstallés depuis la PKI validée, ou absents
  for m in $mods; do
    [[ -f "$STOCK/mods-available/$m" ]] || { log "module absent du paquet : $m"; return 1; }
    ln -s "$STOCK/mods-available/$m" "$RDIR/mods-enabled/$m"
  done
  ln -sfn "$STOCK/mods-config" "$RDIR/mods-config"
  ensure_authlog_dir || { log "dossier du journal des authentifications ($AUTHLOG_DIR) impossible à créer"; return 1; }
  write_authlog_module
  ln -s ../sites-available/ddibuntu "$RDIR/sites-enabled/ddibuntu"
  write_radiusd_conf
  if [[ -n "${2:-}" ]]; then
    local pw=""; [[ -n "${4:-}" && -f "$4/methods" ]] && pw="$(tr -d '\n' < "$4/methods")"
    install_pki "$2" "${3:-true}" "$pw"
    if [[ -n "${4:-}" ]]; then
      install -m 0640 -o root -g "$GROUP" "$4/ldap.mod" "$RDIR/mods-enabled/ldap"
      [[ -f "$4/mschap.mod" ]] && install -m 0640 -o root -g "$GROUP" "$4/mschap.mod" "$RDIR/mods-enabled/mschap"
      [[ -f "$4/ldap-ca.pem" ]] && install -m 0640 -o root -g "$GROUP" "$4/ldap-ca.pem" "$RDIR/certs/ldap-ca.pem"
      [[ -f "$4/mfa.mod" ]] && install -m 0640 -o root -g "$GROUP" "$4/mfa.mod" "$RDIR/mods-enabled/ddibuntu_mfa"   # 0.17.0 : contient le secret client du fournisseur
      if [[ -d "$4/mfa-ca" ]]; then
        install -d -m 0750 -o root -g "$GROUP" "$RDIR/certs/mfa-ca"
        install -m 0640 -o root -g "$GROUP" "$4"/mfa-ca/*.pem "$RDIR/certs/mfa-ca/"
        openssl rehash "$RDIR/certs/mfa-ca" >/dev/null 2>&1 || { log "MFA : autorité du fournisseur illisible (openssl rehash)"; return 1; }
        chown -R root:"$GROUP" "$RDIR/certs/mfa-ca"
      fi
      write_site eap "$4/site.conf" "$4/inner.conf" "$4/mfa.conf"
    else write_site eap; fi
  else write_site; fi
  { printf '# Généré par ddibuntu-radius %s à partir de la console (revalidé par root). Ne pas modifier à la main.\n' "$(ddi_version)"; cat "$1"; } > "$RDIR/clients.conf"
  chown root:"$GROUP" "$RDIR/radiusd.conf" "$RDIR/clients.conf" "$RDIR/sites-available/ddibuntu"
  chmod 0640 "$RDIR/radiusd.conf" "$RDIR/clients.conf" "$RDIR/sites-available/ddibuntu"
}
wipe_ldap() {    # $1 = arborescence ; le module LDAP (mot de passe de liaison) et le module MFA (secret client) sont écrasés avant suppression
  [[ -f "$1/mods-enabled/ldap" ]] && shred -u "$1/mods-enabled/ldap" 2>/dev/null || true
  [[ -f "$1/mods-enabled/ddibuntu_mfa" ]] && shred -u "$1/mods-enabled/ddibuntu_mfa" 2>/dev/null || true
  return 0
}
wipe_certs() {   # $1 = arborescence ; les clés sont écrasées avant suppression
  [[ -d "$1/certs" ]] || return 0
  find "$1/certs" -type f -name '*.key' -exec shred -u {} + 2>/dev/null || true
  rm -rf "$1/certs"
}
restore_tree() {
  if [[ -d "$BACKUP/tree" ]]; then rm -rf "$RDIR"; cp -a "$BACKUP/tree" "$RDIR"; else rm -rf "$RDIR"; fi
}

fw_open() {   # $1 = réseaux (un par ligne) ; vide = referme. Échec : avertissement, le service reste en place.
  local csv; csv="$(printf '%s' "$1" | tr '\n' ',' | sed 's/,$//')"
  if [[ ! -x "$FW_BIN" ]]; then printf 'pare-feu non mis à jour (ddibuntu-fw absent)'; return 0; fi
  if "$FW_BIN" set RADIUS_NETS "$csv" >/dev/null 2>&1 && "$FW_BIN" apply >/dev/null 2>&1; then return 0; fi
  printf 'AVERTISSEMENT : pare-feu non mis à jour, les équipements ne pourront pas joindre le service'
}

cmd_apply() {   # $1 = clients.conf ; $2 = dossier PKI déposé (optionnel : sans lui, EAP-TLS est désactivé) ; $3 = dossier des règles d'accès déposé (optionnel, exige $2)
  local file="${1:-}" pkisrc="${2:-}" authzsrc="${3:-}" nets warn="" had=0 rc=0 snap="" check_crl=true pkiout="" authzout="" authzsnap=""
  [[ -f "$file" && ! -L "$file" ]] || ddi_die "fichier de clients absent"
  [[ "$(stat -c %s "$file")" -le "$MAX_CLIENTS_BYTES" ]] || ddi_die "fichier de clients trop volumineux"
  nets="$(validate_clients "$file")" || return 1
  if grep -qE '^[[:space:]]*virtual_server = ddibuntu-mfa$' "$file" && [[ -z "$authzsrc" ]]; then log "clients MFA : règles d'accès et fournisseur requis (dépôt des règles absent)"; return 1; fi   # sinon le serveur virtuel ddibuntu-mfa n'existerait pas
  [[ -x "$RADIUSD" ]] || { log "freeradius n'est pas installé"; return 1; }
  if [[ -n "$pkisrc" ]]; then
    snap="$(mktemp -d "${TMPDIR:-/tmp}/ddi-radius-pki.XXXXXX")"; chmod 0700 "$snap"
    # shellcheck disable=SC2064
    trap "find '$snap' -type f -exec shred -u {} + 2>/dev/null; rm -rf '$snap'" EXIT   # exécuté à la fin du sous-shell de la demande (ou du script)
    pkiout="$(validate_pki "$pkisrc" "$snap")" || return 1
    check_crl="$(printf '%s\n' "$pkiout" | sed -n 's/^checkCrl=//p')"
    if [[ -n "$authzsrc" ]]; then
      [[ -f "$LDAP_SO" ]] || { log "règles d'accès : le module LDAP de FreeRADIUS est absent (paquet freeradius-ldap à installer)"; return 1; }
      authzout="$(validate_authz "$authzsrc" "$snap" "$file")" || return 1
      if [[ -f "$snap/mfa.mod" && ! -f "$REST_SO" ]]; then log "MFA : le module REST de FreeRADIUS est absent (paquet freeradius-rest à installer)"; return 1; fi
      authzsnap="$snap"
    fi
  elif [[ -n "$authzsrc" ]]; then
    log "règles d'accès : EAP-TLS (PKI) est requis"; return 1
  fi
  # ne JAMAIS changer les droits d'un dossier existant : « install -d -m » les réimpose, et /var/lib/ddibuntu doit rester traversable par la console (ddiconsole)
  [[ -d "$STATE" ]] || install -d -m 0755 "$STATE" 2>/dev/null || true
  rm -rf "$BACKUP"; install -d -m 0700 "$BACKUP"
  if [[ -d "$RDIR" ]]; then cp -a "$RDIR" "$BACKUP/tree"; had=1; fi
  if ! build_tree "$file" "$snap" "$check_crl" "$authzsnap"; then restore_tree; wipe_backup; return 1; fi
  local out
  if ! out="$("$RADIUSD" -d "$RDIR" -Cx -lstdout 2>&1)"; then
    restore_tree; wipe_backup
    log "configuration refusée par freeradius : $(printf '%s' "$out" | tail -n 3 | tr '\n' ' ' | cut -c1-200)"; return 1
  fi
  # PEAP-MSCHAPv2 : winbindd doit tourner AVANT FreeRADIUS (ntlm_auth lui parle) ; sans méthode par mot de passe, winbindd est arrêté
  local wbwarn=""
  if [[ -n "$authzsnap" && -f "$authzsnap/mschap.mod" ]]; then
    winbind_start || wbwarn=" AVERTISSEMENT : winbindd ne démarre pas, PEAP-MSCHAPv2 est indisponible (journal : journalctl -u ${WBSERVICE})."
  else winbind_stop; fi
  "$SYSCTL" daemon-reload >/dev/null 2>&1 || true
  if ! { "$SYSCTL" enable "$SERVICE" >/dev/null 2>&1 && "$SYSCTL" restart "$SERVICE" >/dev/null 2>&1; }; then rc=1; fi
  if [[ "$rc" -eq 0 ]]; then sleep 1; [[ "$(svc_state is-active)" = true ]] || rc=1; fi
  if [[ "$rc" -ne 0 ]]; then
    # 0.14.16 : la raison est dans le journal du service (lue AVANT le retour arrière, qui le redémarre) : lignes d'erreur seulement, courtes, sans rien d'autre
    local why; why="$("$JOURNALCTL" -u "$SERVICE" -n 40 --no-pager -o cat 2>/dev/null | grep -iE 'error|unable|failed|denied|refused|in use|cannot|invalid' | grep -v 'Failed with result\|Failed to start' | tail -n 2 | tr '\n' ' ' | tr -d '\000-\037' | cut -c1-200)" || why=""
    restore_tree; wipe_backup
    if [[ "$had" -eq 1 ]]; then "$SYSCTL" restart "$SERVICE" >/dev/null 2>&1 || true; else "$SYSCTL" disable --now "$SERVICE" >/dev/null 2>&1 || true; fi
    log "le service ne démarre pas ; configuration précédente restaurée${why:+ (journal : ${why% })}"; return 1
  fi
  warn="$(fw_open "$nets")"
  wipe_backup
  local n; n="$(printf '%s' "$nets" | grep -c . || true)" extra=""
  [[ -n "$snap" ]] && extra=" EAP-TLS activé."
  [[ -n "$authzsnap" ]] && extra="$extra Règles d'accès : $(printf '%s' "$authzout" | sed -n 's/^rules=\([0-9]*\) .*/\1/p') règle(s)."
  local meths; meths="$(printf '%s' "$authzout" | sed -n 's/^methods=//p' | head -n1)"
  [[ -z "$meths" ]] || extra="$extra Identifiant et mot de passe : $(printf '%s' "$meths" | sed 's/,/, /g' | tr '[:lower:]' '[:upper:]')."
  printf '%s' "$authzout" | grep -q '^warn:' && extra="$extra $(printf '%s' "$authzout" | sed -n 's/^warn: /AVERTISSEMENT : /p' | tr '\n' ' ')"
  local mfac; mfac="$(printf '%s' "$authzout" | sed -n 's/^mfa=//p' | head -n1)"
  [[ -z "$mfac" ]] || extra="$extra Clients MFA (mot de passe + code) : $(printf '%s' "$mfac" | sed 's/,/, /g')."
  extra="$extra$wbwarn"
  printf '%s' "$pkiout" | grep -q '^warn:' && extra="$extra $(printf '%s' "$pkiout" | sed -n 's/^warn: /AVERTISSEMENT : /p' | tr '\n' ' ')"
  printf 'Service RADIUS démarré (%s client(s)).%s%s' "$n" "$extra" "${warn:+ $warn}"
}
wipe_backup() {   # la sauvegarde de l'arborescence contient les clés (et le mot de passe de liaison) de l'ancien déploiement : écrasés avant suppression
  [[ -d "$BACKUP/tree" ]] && { wipe_certs "$BACKUP/tree"; wipe_ldap "$BACKUP/tree"; }
  rm -rf "$BACKUP"
}
# Installe les CRL déposées. FreeRADIUS ne relit pas un dossier de CRL sur signal (HUP : « No files changed ») et seulement toutes les 10 minutes
# sinon : si le jeu de CRL a changé, le service est donc redémarré (quelques centaines de millisecondes) pour qu'une révocation soit effective
# tout de suite ; s'il n'a pas changé, rien n'est touché. En cas d'échec du redémarrage, les anciennes CRL sont rétablies.
cmd_crl() {   # $1 = dossier PKI déposé (seul crl/ est lu)
  local src="${1:-}" snap check_crl=false out c="$RDIR/certs" f before after
  [[ -f "$c/ca.pem" && -f "$RDIR/mods-enabled/eap" ]] || { log "EAP-TLS n'est pas déployé : déployez d'abord le service"; return 1; }
  grep -q 'check_crl = yes' "$RDIR/mods-enabled/eap" && check_crl=true
  snap="$(mktemp -d "${TMPDIR:-/tmp}/ddi-radius-crl.XXXXXX")"; chmod 0700 "$snap"
  # shellcheck disable=SC2064
  trap "rm -rf '$snap'" EXIT
  out="$(validate_pki "$src" "$snap" crl "$c/ca.pem" "$check_crl")" || return 1
  crl_digest() { (cd "$1" 2>/dev/null && find . -maxdepth 1 -name '*.pem' -type f | sort | xargs -r sha256sum | sha256sum); }
  before="$(crl_digest "$c/crl")"; after="$(crl_digest "$snap/crl")"
  local warns; warns="$(printf '%s' "$out" | sed -n 's/^warn: / AVERTISSEMENT : /p' | tr '\n' ' ')"
  if [[ "$before" = "$after" ]]; then printf 'CRL inchangées : rien à faire.%s' "$warns"; return 0; fi
  rm -rf "$c/crl.new" "$c/crl.old"; install -d -m 0750 -o root -g "$GROUP" "$c/crl.new"
  for f in "$snap"/crl/*.pem; do [[ -e "$f" ]] && install -m 0640 -o root -g "$GROUP" "$f" "$c/crl.new/$(basename "$f")"; done
  compgen -G "$c/crl.new/*.pem" >/dev/null && openssl rehash "$c/crl.new" >/dev/null 2>&1
  mv "$c/crl" "$c/crl.old" && mv "$c/crl.new" "$c/crl"
  if "$SYSCTL" restart "$SERVICE" >/dev/null 2>&1 && { sleep 1; [[ "$(svc_state is-active)" = true ]]; }; then
    rm -rf "$c/crl.old"
    printf 'CRL installées (%s), service redémarré : les révocations sont effectives.%s' "$(compgen -G "$c/crl/*.pem" | wc -l)" "$warns"
  else
    rm -rf "$c/crl"; mv "$c/crl.old" "$c/crl"; "$SYSCTL" restart "$SERVICE" >/dev/null 2>&1 || true
    log "le service ne redémarre pas avec les nouvelles CRL ; anciennes CRL rétablies"; return 1
  fi
}
# ---- Cluster (0.15.0) : actif / passif, l'adresse virtuelle suit le leader PostgreSQL (Keepalived) ----
# RADIUS ne tourne que sur le LEADER : les bornes pointent vers l'adresse virtuelle, qui n'est portée que par le leader. Le secondaire n'a rien d'installé qui réponde :
# « align replica » arrête le service (un ancien leader rétrogradé cesse donc de répondre) ; la console du nouveau leader redéploie le dernier déploiement
# (réglages et secrets sont dans la base répliquée) sans que l'administrateur n'ait rien à faire. Hors cluster (pas de cluster.conf), rien ne change.
in_cluster() { [[ -f "$CLCONF" && ! -L "$CLCONF" ]]; }
cluster_state() {   # rôle de CE nœud, mesuré en direct : standalone | leader | replica | witness | unknown
  in_cluster || { printf standalone; return 0; }
  local r; r="$(timeout 10 "$CLUSTER_CMD" role 2>/dev/null | head -n1 | tr -d '\r\n')" || r=""
  case "$r" in leader|replica|witness) printf '%s' "$r" ;; *) printf unknown ;; esac
}
leader_refusal() {   # imprime la raison et retourne 1 quand ce nœud ne doit rien déployer (dans un cluster, seul le leader le fait)
  case "$(cluster_state)" in
    standalone|leader) return 0 ;;
    replica) printf "ce nœud est le secondaire du cluster : RADIUS se gère depuis le nœud actif (leader PostgreSQL)" ;;
    witness) printf "ce nœud est l'arbitre du cluster : il n'héberge pas RADIUS" ;;
    *) printf "le rôle de ce nœud dans le cluster est inconnu (Patroni injoignable ?) : action refusée par prudence" ;;
  esac
  return 1
}
cmd_align() {   # $1 = leader | replica : rôle Patroni de ce nœud, donné par « ddibuntu-cluster follow »
  case "${1:-}" in
    replica)
      if [[ "$(svc_state is-active)" = true || "$(svc_state is-enabled)" = true ]]; then
        "$SYSCTL" disable --now "$SERVICE" >/dev/null 2>&1 || true
        winbind_stop
        log "ce nœud est le secondaire du cluster : le service RADIUS est arrêté (il tourne sur le leader)"
        cmd_status || true
      fi ;;
    leader) [[ -f "$RUN/radius-status.json" ]] || cmd_status || true ;;   # l'état publié existe toujours : la console sait si le service tourne
    *) ddi_die "align : « leader » ou « replica » attendu" ;;
  esac
}
cmd_stop() {
  "$SYSCTL" disable --now "$SERVICE" >/dev/null 2>&1 || true
  winbind_stop
  local warn; warn="$(fw_open "")"
  printf 'Service RADIUS arrêté.%s' "${warn:+ $warn}"
}

# ---- Demande de la console (sans privilège) : revalidée ici en totalité ----
# Format : {"action":"apply","pki":true|false} (avec radius-clients.conf, et radius-pki/ si pki) | {"action":"stop"} | {"action":"status"} | {"action":"crl"} (avec radius-pki/crl/)
cmd_request() {
  local rq="$GEN/.radius-request" cf="$GEN/radius-clients.conf" pkid="$GEN/radius-pki" azd="$GEN/radius-authz" jd="$GEN/radius-join" raw="" action="" usepki="" useauthz="" out="" rc=0 ok=false
  [[ -e "$rq" || -L "$rq" ]] || return 0
  if [[ -f "$rq" && ! -L "$rq" ]]; then raw="$(head -c 4096 "$rq")"; fi
  rm -f "$rq"
  read -r action usepki useauthz < <(RAW="$raw" python3 - <<'PY' 2>/dev/null || true
import json, os
try: d = json.loads(os.environ["RAW"])
except Exception: raise SystemExit(0)
if isinstance(d, dict) and d.get("action") in ("apply", "stop", "status", "crl", "join", "leave"): print(d["action"], "pki" if d.get("pki") is True else "-", "authz" if d.get("authz") is True else "-")
PY
) || true
  local why=""
  case "$action" in apply|stop|crl) why="$(leader_refusal)" || { out="$why"; rc=1; } ;; esac
  # la jonction se fait sur CHAQUE nœud de données (compte machine propre à chacun), y compris le secondaire : seul l'arbitre n'a rien à joindre
  case "$action" in join|leave) [[ "$(cluster_state)" != witness ]] || { out="ce nœud est l'arbitre du cluster : il n'héberge pas RADIUS"; rc=1; } ;; esac
  [[ "$rc" -ne 0 ]] || case "$action" in
    apply)
      if [[ -f "$cf" && ! -L "$cf" ]]; then out="$( ( cmd_apply "$cf" "$([[ "$usepki" = pki ]] && echo "$pkid")" "$([[ "$useauthz" = authz ]] && echo "$azd")" ) 2>&1)" || rc=$?; else out="fichier de clients non déposé"; rc=1; fi ;;
    crl) out="$( ( cmd_crl "$pkid" ) 2>&1)" || rc=$? ;;
    join) out="$( ( cmd_join "$jd" ) 2>&1)" || rc=$? ;;
    leave) out="$( ( cmd_leave "$jd" ) 2>&1)" || rc=$? ;;
    stop) out="$( ( cmd_stop ) 2>&1)" || rc=$? ;;
    status) out="état publié" ;;
    *) out="demande invalide"; rc=1 ;;
  esac
  # les secrets déposés par la console ne restent jamais sur le disque, même en cas de refus
  if [[ -e "$cf" || -L "$cf" ]]; then if [[ -f "$cf" && ! -L "$cf" ]]; then shred -u "$cf" 2>/dev/null || rm -f "$cf"; else rm -f "$cf"; fi; fi
  if [[ -d "$pkid" && ! -L "$pkid" ]]; then find "$pkid" -type f -exec shred -u {} + 2>/dev/null || true; fi   # la clé privée du serveur ne reste jamais sur le disque
  rm -rf "$pkid"
  if [[ -d "$azd" && ! -L "$azd" ]]; then find "$azd" -type f -exec shred -u {} + 2>/dev/null || true; fi   # le mot de passe de liaison ne reste jamais sur le disque
  rm -rf "$azd"
  if [[ -d "$jd" && ! -L "$jd" ]]; then find "$jd" -type f -exec shred -u {} + 2>/dev/null || true; fi   # le compte qui joint le domaine ne reste jamais sur le disque
  rm -rf "$jd"
  [[ "$rc" -eq 0 ]] && ok=true
  out="$(printf '%s' "$out" | tr '\n\r' '  ' | sed 's/ddibuntu-radius: //g')"
  log "demande de la console (${action:-invalide}) : ${out:-ok}"
  publish_result "${action:-invalide}" "$ok" "$out"
  cmd_status || true
  [[ "$ok" = true ]]
}

# validation seule : aucun effet, utilisable sans privilège (tests, diagnostic)
if [[ "${1:-}" = check ]]; then validate_clients "${2:-}"; exit $?; fi
if [[ "${1:-}" = check-pki ]]; then t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT; validate_pki "${2:-}" "$t"; exit $?; fi
# shellcheck disable=SC2064
if [[ "${1:-}" = check-authz ]]; then t="$(mktemp -d)"; trap "find '$t' -type f -exec shred -u {} + 2>/dev/null; rm -rf '$t'" EXIT; validate_authz "${2:-}" "$t" "${3:-}" && { for f in ldap.mod site.conf inner.conf mschap.mod mfa.conf mfa.mod; do if [[ -f "$t/$f" ]]; then cat "$t/$f"; fi; done | sed -E -e 's/^(\tpassword = ).*/\1"***"/' -e 's/(client_secret=)[^&"]*/\1***/'; }; exit $?; fi
[[ "$(id -u)" -eq 0 ]] || ddi_die "à lancer en root"
exec 9>"${DDI_RADIUS_LOCK:-/run/ddibuntu-radius.lock}"
flock -w 120 9 || ddi_die "une autre demande RADIUS est en cours depuis plus de 2 minutes"
cmd="${1:-}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  apply) cmd_apply "${1:-}" "${2:-}" "${3:-}"; echo; cmd_status ;;
  crl) cmd_crl "${1:-$GEN/radius-pki}"; echo; cmd_status ;;
  stop) cmd_stop; echo; cmd_status ;;
  status) cmd_status ;;
  request) cmd_request ;;
  align) cmd_align "${1:-}" ;;
  join) cmd_join "${1:-$GEN/radius-join}"; echo; cmd_status ;;
  leave) cmd_leave "${1:-}"; echo; cmd_status ;;
  *) usage >&2; exit 2 ;;
esac
