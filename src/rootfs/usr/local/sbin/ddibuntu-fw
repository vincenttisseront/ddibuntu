#!/bin/bash
# ddibuntu-fw — pare-feu nftables dans une table dédiée (inet ddibuntu).
# Entrée refusée par défaut ; ports d'administration réservés aux réseaux d'administration ;
# application avec retour arrière automatique (anti-verrouillage).
set -euo pipefail

DDI_LIBDIR="${DDI_LIBDIR:-/usr/local/lib/ddibuntu}"
# shellcheck source=/dev/null
. "$DDI_LIBDIR/common.sh"

FW_CONF="${DDI_FW_CONF:-$DDI_CONFDIR/firewall.conf}"
NFT_FILE="${DDI_NFT_FILE:-$DDI_CONFDIR/nftables.nft}"
STATE="${DDI_FW_STATE:-$DDI_STATEDIR}"
PIDFILE="$STATE/fw-rollback.pid"
PREV="$STATE/fw-previous.nft"
PREV_FILE="$STATE/nftables.nft.prev"

usage() {
  cat <<'USAGE'
Usage : ddibuntu-fw <commande>
  render               écrit les règles sur la sortie standard
  write                écrit /etc/ddibuntu/nftables.nft (sans l'appliquer)
  check                vérifie la syntaxe des règles (nft -c)
  apply [--confirm N]  applique ; avec --confirm, retour arrière après N s sans « confirm »
  confirm              valide une application en attente
  rollback             revient immédiatement aux règles précédentes
  set CLE VALEUR       modifie ADMIN_NETS, OPEN_TCP, OPEN_UDP, ADMIN_TCP ou CLUSTER_PEERS
  status               affiche les règles actives
USAGE
}

fw_load() {
  ADMIN_NETS=""; OPEN_TCP=""; OPEN_UDP=""; ADMIN_TCP="22,443"; CLUSTER_PEERS=""
  [ -f "$FW_CONF" ] || return 0
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    k="${line%%=*}"; v="${line#*=}"; v="${v#\"}"; v="${v%\"}"
    case "$k" in ADMIN_NETS|OPEN_TCP|OPEN_UDP|ADMIN_TCP|CLUSTER_PEERS) ;; *) ddi_die "clé inconnue dans firewall.conf : $k" ;; esac
    if [[ "$v" =~ [[:cntrl:]\"\'] ]]; then ddi_die "valeur invalide pour $k"; fi
    printf -v "$k" '%s' "$v"
  done < "$FW_CONF"
}

fw_ports() {   # "22,443" -> "22, 443" ; vide -> vide
  local p out=""
  for p in $(printf '%s' "$1" | tr ',' ' '); do
    if ! { [[ "$p" =~ ^[0-9]{1,5}$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ]; }; then
      ddi_die "port invalide : $p"
    fi
    out="${out:+$out, }$p"
  done
  printf '%s' "$out"
}

fw_nets() {    # $1 = 4|6 ; réseaux d'administration de cette famille, normalisés
  local n norm fam out=""
  while IFS= read -r n || [ -n "$n" ]; do
    norm="$(ddi_norm_net "$n")" || ddi_die "réseau d'administration invalide : $n"
    case "$norm" in *:*) fam=6 ;; *) fam=4 ;; esac
    if [ "$fam" = "$1" ]; then out="${out:+$out, }$norm"; fi
  done < <(ddi_split_list "$ADMIN_NETS")
  printf '%s' "$out"
}

# Pairs du cluster (réseau dédié) : adresses IPv4 seulement ; uniquement ces sources atteignent quorum (2379/2380), PostgreSQL (5432) et l'API Patroni (8008).
fw_cluster() {
  local n norm out=""
  while IFS= read -r n || [ -n "$n" ]; do
    norm="$(ddi_norm_net "$n")" || ddi_die "pair de cluster invalide : $n"
    case "$norm" in *:*) ddi_die "pair de cluster : IPv4 uniquement ($n)" ;; esac
    out="${out:+$out, }$norm"
  done < <(ddi_split_list "$CLUSTER_PEERS")
  printf '%s' "$out"
}

fw_render() {
  fw_load
  local v4 v6 at ot ou e4="" e6="" r_admin4="" r_admin6="" r_tcp="" r_udp="" cp ec="" r_cluster=""
  # « || return 1 » : set -e est inopérant quand la fonction est appelée dans un « if »
  v4="$(fw_nets 4)" || return 1
  v6="$(fw_nets 6)" || return 1
  cp="$(fw_cluster)" || return 1
  if [ -n "$cp" ]; then ec="    elements = { $cp }"; r_cluster="    ip saddr @cluster4 tcp dport { 2379, 2380, 5432, 8008 } accept"; fi
  at="$(fw_ports "$ADMIN_TCP")" || return 1
  ot="$(fw_ports "$OPEN_TCP")" || return 1
  ou="$(fw_ports "$OPEN_UDP")" || return 1
  if [ -n "$v4" ]; then e4="    elements = { $v4 }"; fi
  if [ -n "$v6" ]; then e6="    elements = { $v6 }"; fi
  if [ -n "$at" ]; then
    r_admin4="    ip saddr @admin4 tcp dport { $at } accept"
    r_admin6="    ip6 saddr @admin6 tcp dport { $at } accept"
  fi
  if [ -n "$ot" ]; then r_tcp="    tcp dport { $ot } accept"; fi
  if [ -n "$ou" ]; then r_udp="    udp dport { $ou } accept"; fi
  cat <<EOF
#!/usr/sbin/nft -f
# Généré par ddibuntu-fw $(ddi_version) à partir de firewall.conf. Ne pas modifier à la main.
add table inet ddibuntu
delete table inet ddibuntu

table inet ddibuntu {
  set admin4 {
    type ipv4_addr
    flags interval
${e4}
  }
  set admin6 {
    type ipv6_addr
    flags interval
${e6}
  }
  set cluster4 {
    type ipv4_addr
    flags interval
${ec}
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state invalid drop
    ct state established,related accept
    ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    ip protocol icmp icmp type echo-request limit rate 20/second burst 50 packets accept
    meta l4proto 58 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
    meta l4proto 58 icmpv6 type echo-request limit rate 20/second burst 50 packets accept
    udp sport 67 udp dport 68 accept
    ip6 daddr fe80::/10 udp dport 546 accept
${r_admin4}
${r_admin6}
${r_cluster}
${r_tcp}
${r_udp}
    limit rate 5/minute burst 10 packets log prefix "ddibuntu-drop: " level info
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
EOF
}

fw_write() {
  mkdir -p "$(dirname "$NFT_FILE")"
  local tmp
  tmp="$(mktemp "$NFT_FILE.XXXXXX")"
  if ! fw_render > "$tmp"; then rm -f "$tmp"; ddi_die "rendu des règles impossible"; fi
  chmod 0644 "$tmp"
  mv -f "$tmp" "$NFT_FILE"
}

fw_check() {
  local tmp rc=0
  tmp="$(mktemp)"
  fw_render > "$tmp" || { rm -f "$tmp"; return 1; }
  nft -c -f "$tmp" || rc=$?
  rm -f "$tmp"
  return "$rc"
}

fw_disarm() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true   # le minuteur a pu se terminer entre-temps
    rm -f "$PIDFILE"
  fi
}

fw_arm() {
  fw_disarm
  setsid "$0" _timer "$1" </dev/null >/dev/null 2>&1 &
  echo "$!" > "$PIDFILE"
}

fw_apply() {
  local confirm=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift ;;
      *) usage >&2; exit 2 ;;
    esac
    shift
  done
  [[ "$confirm" =~ ^[0-9]+$ ]] || ddi_die "--confirm attend un nombre de secondes"
  ddi_offline && ddi_die "apply est refusé en mode hors-ligne (utiliser write)"
  mkdir -p "$STATE" "$(dirname "$NFT_FILE")"
  fw_check || ddi_die "règles invalides, rien n'a été appliqué"
  # sauvegarde des règles actives et du fichier persistant, pour le retour arrière
  if nft list table inet ddibuntu > "$PREV.tmp" 2>/dev/null; then
    mv -f "$PREV.tmp" "$PREV"; rm -f "$PREV.absent"
  else
    rm -f "$PREV.tmp" "$PREV"; : > "$PREV.absent"
  fi
  if [ -f "$NFT_FILE" ]; then cp -p "$NFT_FILE" "$PREV_FILE"; else rm -f "$PREV_FILE"; fi
  fw_write
  nft -f "$NFT_FILE"
  if [ "$confirm" -gt 0 ]; then
    fw_arm "$confirm"
    printf 'Retour arrière automatique dans %s s ; lancer « ddibuntu-fw confirm » pour conserver.\n' "$confirm"
  fi
}

fw_rollback() {
  rm -f "$PIDFILE"
  if [ -f "$PREV" ]; then
    { echo "add table inet ddibuntu"; echo "delete table inet ddibuntu"; cat "$PREV"; } > "$PREV.load"
    nft -f "$PREV.load"
    rm -f "$PREV.load"
  elif [ -f "$PREV.absent" ]; then
    if nft list table inet ddibuntu >/dev/null 2>&1; then nft delete table inet ddibuntu; fi
  else
    ddi_die "aucune sauvegarde de règles précédentes"
  fi
  if [ -f "$PREV_FILE" ]; then cp -p "$PREV_FILE" "$NFT_FILE"; fi
  printf 'Règles précédentes restaurées.\n'
}

fw_set() {
  local k="${1:-}" v="${2-}" bak="" tmp
  case "$k" in ADMIN_NETS|OPEN_TCP|OPEN_UDP|ADMIN_TCP|CLUSTER_PEERS) ;; *) ddi_die "clé inconnue : $k" ;; esac
  if [[ "$v" =~ [[:cntrl:]\"\'] ]]; then ddi_die "valeur invalide"; fi
  fw_load
  printf -v "$k" '%s' "$v"
  mkdir -p "$(dirname "$FW_CONF")"
  if [ -f "$FW_CONF" ]; then bak="$(mktemp)"; cp -p "$FW_CONF" "$bak"; fi
  tmp="$(mktemp)"
  {
    printf '# Paramètres du pare-feu DDI-Buntu (lus par ddibuntu-fw)\n'
    printf 'ADMIN_NETS="%s"\n' "$ADMIN_NETS"
    printf 'OPEN_TCP="%s"\n' "$OPEN_TCP"
    printf 'OPEN_UDP="%s"\n' "$OPEN_UDP"
    printf 'ADMIN_TCP="%s"\n' "$ADMIN_TCP"
    printf 'CLUSTER_PEERS="%s"\n' "$CLUSTER_PEERS"
  } > "$tmp"
  mv -f "$tmp" "$FW_CONF"; chmod 0644 "$FW_CONF"
  # validation par le rendu : en cas d'échec, l'ancien fichier est restauré
  if ! fw_render >/dev/null; then
    if [ -n "$bak" ]; then mv -f "$bak" "$FW_CONF"; else rm -f "$FW_CONF"; fi
    ddi_die "valeur refusée pour $k"
  fi
  if [ -n "$bak" ]; then rm -f "$bak"; fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  render)   fw_render ;;
  write)    fw_write ;;
  check)    fw_check ;;
  apply)    fw_apply "$@" ;;
  confirm)  if [ -f "$PIDFILE" ]; then fw_disarm; printf 'Règles conservées.\n'; else printf 'Aucune application en attente.\n'; fi ;;
  rollback) fw_rollback ;;
  set)      fw_set "$@" ;;
  status)   nft list table inet ddibuntu ;;
  _timer)   # interne : retour arrière différé
    echo "$$" > "$PIDFILE"
    sleep "${1:?}"
    if [ -f "$PIDFILE" ] && [ "$(cat "$PIDFILE")" = "$$" ]; then fw_rollback; fi
    ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
