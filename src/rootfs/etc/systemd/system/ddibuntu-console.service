[Unit]
Description=DDI-Buntu web console (HTTPS)
After=postgresql.service ddibuntu-db-init.service network-online.target
Wants=postgresql.service ddibuntu-db-init.service
ConditionPathExists=/etc/ddibuntu/console.env

[Service]
User=ddiconsole
Group=ddiconsole
EnvironmentFile=/etc/ddibuntu/console.env
# Auto-réparation (« + » : avec les droits complets, hors du bac à sable de l'unité) : le dossier de dépôt doit appartenir à la console, sinon plus aucun
# déploiement ni demande à root n'est possible (EACCES). -h : jamais de suivi de lien symbolique.
ExecStartPre=+/usr/bin/chmod go+x /var/lib/ddibuntu
ExecStartPre=+/usr/bin/install -d -m 0750 -o ddiconsole -g ddiconsole /var/lib/ddibuntu/generated
ExecStartPre=+/usr/bin/chown -Rh ddiconsole:ddiconsole /var/lib/ddibuntu/generated
ExecStart=/usr/local/lib/ddibuntu/console-start
Restart=on-failure
RestartSec=3
# Moindre privilège : écriture seulement dans le dossier de dépôt ; le port 443 par capacité, pas par root
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ddibuntu/generated
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
# AF_NETLINK : lecture seule de la liste des adresses du serveur (assistants du cluster) ; aucune capacité réseau n'est accordée, rien ne peut être modifié
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
